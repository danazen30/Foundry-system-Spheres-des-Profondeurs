<div class="sdp-dialog sdp-skill-selector">

  <label>
    {{#if (eq itemType "talent")}}
      {{localize "TYPES.Item.talent"}}
    {{else}}
      {{localize "SDP.Skill"}}
    {{/if}}
  </label>

  <input
    type="search"
    id="skill-filter"
    placeholder="{{localize "SDP.Search"}}">

  <select id="skill-select" size="12"></select>

  <button id="confirm">
    {{localize "SDP.Add"}}
  </button>

</div>
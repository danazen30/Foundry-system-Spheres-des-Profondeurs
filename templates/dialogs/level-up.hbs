<div class="level-up-container" style="max-height: 350px; overflow-y: auto;">

  <h2>
    {{localize "SDP.LevelUp"}}
    → {{level}}
  </h2>

  <p>{{localize "SDP.HealthGain"}}:</p>

  <button data-action="roll">
    {{localize "SDP.Roll"}} {{dice}}
  </button>

  <button data-action="average">
    {{localize "SDP.TakeAverage"}} ({{average}})
  </button>

{{#if (ne signDice null)}}
  <hr>

  <h3>{{localize "SDP.SignBonus"}}</h3>

  <p>
    {{localize "SDP.Dice"}}:
    {{signDice}}
  </p>

  <button data-action="sign-roll">
    {{localize "SDP.RollSign"}}
  </button>

  <button data-action="sign-average">
    {{localize "SDP.AverageSign"}} ({{signAverage}})
  </button>
{{/if}}

<hr>

<button data-action="confirm">
  {{localize "SDP.ConfirmLevelUp"}}
</button>

</div>
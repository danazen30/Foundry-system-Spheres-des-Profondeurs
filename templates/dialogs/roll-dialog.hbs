<div class="sdp-roll-dialog" style="overflow-y: auto; max-height: 100%;">

<h2>{{label}}</h2>

<!-- ===================== -->
<!-- MODIFIERS -->
<!-- ===================== -->

<h3>{{localize "SDP.Modifiers"}}</h3>

<label>{{localize "SDP.Difficulty"}}</label>
<select name="difficulty">
  <option value="60">+60</option>
  <option value="40">+40</option>
  <option value="20">+20</option>
  <option value="10">+10</option>
  <option value="0" selected>0</option>
  <option value="-10">-10</option>
  <option value="-20">-20</option>
  <option value="-40">-40</option>
  <option value="-60">-60</option>
</select>

<label>{{localize "SDP.Custom"}}</label>
<input type="number" name="customMod" value="0">

<div class="modifier-box">

  {{localize "SDP.Modifier"}}:
  <span id="totalModifier">0</span>

  <div class="modifier-tooltip">
    {{#each modifiers}}
      <div>{{this.label}} : {{this.value}}</div>
    {{/each}}
  </div>

</div>

{{#if (and (eq type "skill") (not isAttribute))}}

<h3>{{localize "SDP.Attributes"}}</h3>

<select name="attributeOverride">

  <option value="">
    {{localize "SDP.Default"}}
  </option>

  <option value="meleeAbility">
    {{localize "SDP.MeleeAbility"}}
  </option>

  <option value="rangedAbility">
    {{localize "SDP.RangedAbility"}}
  </option>

  <option value="strength">
    {{localize "SDP.Strength"}}
  </option>

  <option value="toughness">
    {{localize "SDP.Toughness"}}
  </option>

  <option value="initiative">
    {{localize "SDP.Initiative"}}
  </option>

  <option value="agility">
    {{localize "SDP.Agility"}}
  </option>

  <option value="dexterity">
    {{localize "SDP.Dexterity"}}
  </option>

  <option value="intelligence">
    {{localize "SDP.Intelligence"}}
  </option>

  <option value="willpower">
    {{localize "SDP.Willpower"}}
  </option>

  <option value="charisma">
    {{localize "SDP.Charisma"}}
  </option>

</select>

{{/if}}

<h3>{{localize "SDP.Talents"}}</h3>

{{#each talents}}
<label>
  <input type="checkbox" name="talent" value="{{this.id}}">
  {{this.name}} ({{this.advances}})
</label>
{{/each}}

{{#each effects}}
<label>
  <input type="checkbox" name="effect" value="{{this.id}}">
  {{this.name}}
</label>
{{/each}}

<!-- ===================== -->
<!-- INSPIRATION -->
<!-- ===================== -->

{{#if inspirationDice}}
<div class="inspiration-block">

  <h3>{{localize "SDP.Inspiration"}}</h3>

  <p>
    {{localize "SDP.Dice"}}:
    {{inspirationDice}}
  </p>

  <button data-action="rollInspiration">
    {{localize "SDP.RollInspiration"}}
  </button>

  {{#if inspirationResult}}
    <p>
      <strong>
        {{localize "SDP.BonusSL"}}:
      </strong>
      +{{inspirationResult}}
    </p>
  {{/if}}

</div>
{{/if}}

<!-- ===================== -->
<!-- COMBAT -->
<!-- ===================== -->

{{#if (or isAttack isSpell)}}

<h3>{{localize "SDP.Combat"}}</h3>

<label>{{localize "SDP.HitTable"}}</label>

<select name="hitLocationProfile">

  {{#each hitProfiles}}

    <option value="{{@key}}">
  {{localize this.label}}
</option>

  {{/each}}

</select>

<label>{{localize "SDP.Target"}}</label>

<select name="location">

  <option value="">
    {{localize "SDP.Random"}}
  </option>

  {{#each hitLocations}}

    <option value="{{this.key}}">
      {{this.label}}
      ({{this.modifier}})
    </option>

  {{/each}}

</select>

<label>
  <input type="checkbox" name="brutal">
  {{localize "SDP.BrutalStrike"}}
</label>

<label>
  <input type="checkbox" name="charge">
  {{localize "SDP.ChargeAttack"}}
</label>

{{#if hasFinesseTrait}}
<label>
  <input type="checkbox" name="finesse"/>
  {{localize "SDP.UseFinesse"}}
</label>
{{/if}}

{{/if}}

<!-- ===================== -->
<!-- BUTTON -->
<!-- ===================== -->

<button data-action="roll">
  {{localize "SDP.Roll"}}
</button>

</div>
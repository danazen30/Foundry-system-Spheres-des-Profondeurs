<div class="sdp-roll-dialog">

<h2>{{label}}</h2>

<!-- ===================== -->
<!-- MODIFIERS -->
<!-- ===================== -->

<h3>Modifiers</h3>

<label>Difficulty</label>
<select name="difficulty">
  <option value="60">+60</option>
  <option value="40">+40</option>
  <option value="20">+20</option>
  <option value="10">+10</option>
  <option value="0" selected>0</option>
  <option value="-10">-10</option>
  <option value="-20">-20</option>
  <option value="-40">-40</option>
  <option value="-60">-60</option>
</select>

<label>Custom</label>
<input type="number" name="customMod" value="0">

<!-- ===================== -->
<!-- EFFECTS -->
<!-- ===================== -->

<h3>Active Effects</h3>

<h3>Talents</h3>

{{#each talents}}
<label>
  <input type="checkbox" name="talent" value="{{this.id}}">
  {{this.name}} ({{this.system.advances}})
</label>
{{/each}}

{{#each effects}}
<label>
  <input type="checkbox" name="effect" value="{{this.id}}">
  {{this.name}}
</label>
{{/each}}

<!-- ===================== -->
<!-- COMBAT -->
<!-- ===================== -->

{{#if isAttack}}

<h3>Combat</h3>

<label>Target</label>
<select name="location">
  <option value="">Random</option>
  <option value="body">Body (-10)</option>
  <option value="arm">Arm (-20)</option>
  <option value="leg">Leg (-20)</option>
  <option value="head">Head (-30)</option>
</select>

<label>
  <input type="checkbox" name="brutal">
  Brutal Strike
</label>

{{/if}}

<h3>Conditions</h3>

<p>Total: {{conditionMod}}</p>

<ul>
{{#each conditionDetails}}
  <li>{{this.name}}: {{this.value}}</li>
{{/each}}
</ul>

</div>
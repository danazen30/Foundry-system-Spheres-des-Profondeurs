<div class="sdp-roll-dialog" style="overflow-y: auto; max-height: 100%;">

<h2>{{label}}</h2>

<!-- ===================== -->
<!-- MODIFIERS -->
<!-- ===================== -->

<h3>Modifiers</h3>

<label>Difficulty</label>
<select name="difficulty">
  <option value="60">+60</option>
  <option value="40">+40</option>
  <option value="20">+20</option>
  <option value="10">+10</option>
  <option value="0" selected>0</option>
  <option value="-10">-10</option>
  <option value="-20">-20</option>
  <option value="-40">-40</option>
  <option value="-60">-60</option>
</select>

<label>Custom</label>
<input type="number" name="customMod" value="0">

<div class="modifier-box">

  Modifier: <span id="totalModifier">0</span>

  <div class="modifier-tooltip">
    {{#each modifiers}}
      <div>{{this.label}} : {{this.value}}</div>
    {{/each}}
  </div>

</div>

{{#if (and (eq type "skill") (not isAttribute))}}

<h3>Attribute</h3>

<select name="attributeOverride">
  <option value="">Default</option>
  <option value="meleeAbility">Melee Ability</option>
  <option value="rangedAbility">Ranged Ability</option>
  <option value="strength">Strength</option>
  <option value="toughness">Toughness</option>
  <option value="initiative">Initiative</option>
  <option value="agility">Agility</option>
  <option value="dexterity">Dexterity</option>
  <option value="intelligence">Intelligence</option>
  <option value="willpower">Willpower</option>
  <option value="charisma">Charisma</option>
</select>

{{/if}}

<h3>Talents</h3>

{{#each talents}}
<label>
  <input type="checkbox" name="talent" value="{{this.id}}">
  {{this.name}} ({{this.system.advances}})
</label>
{{/each}}

{{#each effects}}
<label>
  <input type="checkbox" name="effect" value="{{this.id}}">
  {{this.name}}
</label>
{{/each}}

<!-- ===================== -->
<!-- INSPIRATION (GLOBAL) -->
<!-- ===================== -->

{{#if inspirationDice}}
<div class="inspiration-block">
  <h3>Inspiration</h3>

  <p>Dice: {{inspirationDice}}</p>

  <button data-action="rollInspiration">
    Roll Inspiration
  </button>

  {{#if inspirationResult}}
    <p><strong>Bonus SL:</strong> +{{inspirationResult}}</p>
  {{/if}}

</div>
{{/if}}

<!-- ===================== -->
<!-- COMBAT ONLY -->
<!-- ===================== -->

{{#if isAttack}}

<h3>Combat</h3>

<label>Target</label>
<select name="location">
  <option value="">Random</option>
  <option value="body">Body (-10)</option>
  <option value="arm">Arm (-20)</option>
  <option value="leg">Leg (-20)</option>
  <option value="head">Head (-30)</option>
</select>

<label>
  <input type="checkbox" name="brutal">
  Brutal Strike
</label>

<label>
  <input type="checkbox" name="charge">
  Charge (+1 melee attack)
</label>

<label>
  <input type="checkbox" name="finesse"/>
  Use Finesse (DEX)
</label>

{{/if}}

<!-- ===================== -->
<!-- BUTTON (TOUJOURS VISIBLE) -->
<!-- ===================== -->

<button data-action="roll">Roll</button>

</div>
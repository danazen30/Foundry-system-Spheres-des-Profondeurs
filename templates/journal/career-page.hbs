<article class="sdp-career-journal sdp-career-view-{{view}}">

  {{#if showIntro}}
  <header class="sdp-career-header">
    <h1>{{title}}</h1>
  </header>

  {{#if epigraph1}}
  <blockquote class="sdp-career-epigraph">
    {{{epigraph1}}}
  </blockquote>
  {{/if}}

  {{#if epigraph2}}
  <blockquote class="sdp-career-epigraph">
    {{{epigraph2}}}
  </blockquote>
  {{/if}}

  {{#if intro}}
  <div class="sdp-career-intro">
    {{{intro}}}
  </div>
  {{/if}}

  {{#if species}}
  <p class="sdp-career-meta">
    <strong>{{localize "SDP.Journal.Career.SpeciesLabel"}}:</strong>
    {{species}}
  </p>
  {{/if}}

  {{#if group}}
  <p class="sdp-career-meta">
    <strong>{{localize "SDP.CareerGroup"}}:</strong>
    {{group}}
  </p>
  {{/if}}

  {{#if progressionTable}}
  <section class="sdp-career-progression">
    <h2 class="sdp-career-progression-title">
      {{localize "SDP.Journal.Career.ProgressionTitle"}}
    </h2>
    <table class="sdp-career-progression-table">
      <thead>
        <tr>
          <th></th>
          {{#each progressionTable.columns}}
          <th>{{abbr}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each progressionTable.rows}}
        <tr>
          <th>{{roman}}</th>
          {{#each cells}}
          <td>{{this}}</td>
          {{/each}}
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>
  {{/if}}
  {{/if}}

  {{#if missingTiers}}
  <p class="sdp-career-error">
    {{localize "SDP.Journal.Career.MissingTiers" key=journalKey}}
  </p>
  {{/if}}

  {{#if showTiers}}
  {{#unless showIntro}}
  <header class="sdp-career-header sdp-career-header-compact">
    <h1>{{title}}</h1>
  </header>
  {{/unless}}

  {{#each tiers}}
  <section class="sdp-career-tier">

    <h2 class="sdp-career-tier-title">{{heading}}</h2>

    {{#if standing}}
    <p class="sdp-career-field">
      <strong>{{localize "SDP.Standing"}}:</strong>
      {{standing}}
    </p>
    {{/if}}

    {{#if skillsHtml}}
    <div class="sdp-career-field">
      <strong>{{localize "SDP.Skills"}}:</strong>
      <div class="sdp-career-field-body">
        {{{skillsHtml}}}
      </div>
    </div>
    {{/if}}

    {{#if talentsHtml}}
    <div class="sdp-career-field">
      <strong>{{localize "SDP.Talents"}}:</strong>
      <div class="sdp-career-field-body">
        {{{talentsHtml}}}
      </div>
    </div>
    {{/if}}

    {{#if workSkillHtml}}
    <div class="sdp-career-field">
      <strong>{{localize "SDP.WorkSkill"}}:</strong>
      <div class="sdp-career-field-body">
        {{{workSkillHtml}}}
      </div>
    </div>
    {{/if}}

    {{#if trappings}}
    <p class="sdp-career-field">
      <strong>{{localize "SDP.Trappings"}}:</strong>
      {{trappings}}
    </p>
    {{/if}}

    {{#if sheetLink}}
    <p class="sdp-career-sheet-link">
      {{{sheetLink}}}
    </p>
    {{/if}}

  </section>
  {{/each}}
  {{/if}}

</article>

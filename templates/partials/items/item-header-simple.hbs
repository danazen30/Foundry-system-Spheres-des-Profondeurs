<div class="item-header">

  <div class="item-header-body">

    <div class="item-header-image">

      <img
        src="{{item.img}}"
        alt="{{item.name}}" />

    </div>

    <div class="item-header-main">

      <div class="item-name-row">

        <input
          type="text"
          name="name"
          value="{{item.displayName}}"
          placeholder="{{localize 'SDP.ItemName'}}" />

        {{#if item.nameSuffix}}
          <span class="item-name-suffix">{{item.nameSuffix}}</span>
        {{/if}}

      </div>

      <div class="item-meta-wrapper">

        <div class="item-meta-grid top-row">

          <div class="meta-field">

            <label>{{localize "SDP.Type"}}</label>

            <div class="meta-value">
              {{localize (concat "TYPES.Item." item.type)}}
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>
<div class="item-header">

  <div class="item-header-body">

    <div class="item-header-image">

      <img
        src="{{item.img}}"
        alt="{{item.name}}" />

    </div>

    <div class="item-header-main">

      <div class="item-name-row">

        <input
          type="text"
          name="name"
          value="{{item.name}}" />

      </div>

      <div class="item-meta-wrapper">

        <div class="item-meta-grid top-row">

          <div class="meta-field">

            <label>Type</label>

            <div class="meta-value">
              {{item.type}}
            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</div>
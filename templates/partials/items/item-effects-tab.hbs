<div class="item-effects-tab">

  <div class="effects-header">

    <h2>{{localize "SDP.Effects"}}</h2>

    <button
      type="button"
      class="effect-create-button"
      data-action="create-effect">

      ✚ {{localize "SDP.AddEffect"}}

    </button>

  </div>

  <ol class="effects-list">

    {{#each effects}}

    <li
      class="effect effect-row flexrow"
      data-effect-id="{{this.id}}">

      <div class="effect-name">
        {{this.name}}
      </div>

      <div class="effect-controls">

        <button
          type="button"
          class="effect-control"
          data-action="edit-effect"
          title="{{localize 'SDP.Edit'}}">

          ✏️

        </button>

        <button
          type="button"
          class="effect-control"
          data-action="delete-effect"
          title="{{localize 'SDP.Delete'}}">

          🗑️

        </button>

      </div>

    </li>

    {{/each}}

  </ol>

</div>
<div class="item-description-tab">

  <!-- DESCRIPTION -->
  <div class="resource-block note-block">

    <div class="note-header">

      <label>{{localize "SDP.TabDescription"}}</label>

      <button
        type="button"
        class="note-edit-btn"
        data-action="toggleEditor"
        data-target="description">

        ✏️ {{localize "SDP.Edit"}}

      </button>

    </div>

    <!-- DISPLAY -->
    <div
      class="note-display"
      data-display="description">

      {{{editors.description}}}

    </div>

    <!-- EDITOR -->
    <div
      class="note-editor"
      data-editor="description"
      style="display:none;">

      <prose-mirror
  name="system.description"
  value="{{system.description}}">

  {{{editors.description}}}

</prose-mirror>

    </div>

  </div>

  <!-- PLAYER NOTES -->
  <div class="resource-block note-block">

    <div class="note-header">

      <label>
  {{localize "SDP.PlayerNotes"}}
</label>

      <button
        type="button"
        class="note-edit-btn"
        data-action="toggleEditor"
        data-target="playerNotes">

        ✏️ {{localize "SDP.Edit"}}

      </button>

    </div>

    <div
      class="note-display"
      data-display="playerNotes">

      {{{editors.playerNotes}}}

    </div>

    <div
      class="note-editor"
      data-editor="playerNotes"
      style="display:none;">

      <prose-mirror
        name="system.playerNotes"
        value="{{system.playerNotes}}">

        {{{system.playerNotes}}}

      </prose-mirror>

    </div>

  </div>

{{#if isGM}}
  <!-- GM NOTES -->
  <div class="resource-block note-block">

    <div class="note-header">

      <label>
  {{localize "SDP.GMNotes"}}
</label>

      <button
        type="button"
        class="note-edit-btn"
        data-action="toggleEditor"
        data-target="gmNotes">

        ✏️ {{localize "SDP.Edit"}}

      </button>

    </div>

    <div
      class="note-display"
      data-display="gmNotes">

      {{{editors.gmNotes}}}

    </div>

    <div
      class="note-editor"
      data-editor="gmNotes"
      style="display:none;">

      <prose-mirror
        name="system.gmNotes"
        value="{{system.gmNotes}}">

        {{{system.gmNotes}}}

      </prose-mirror>

    </div>

  </div>
  {{/if}}

</div>
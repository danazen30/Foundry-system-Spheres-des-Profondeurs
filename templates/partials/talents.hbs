<div class="tab-talents">

  <table class="talents-table">

    <thead>
      <tr>
        <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.Level"}}</th>
<th>{{localize "SDP.Max"}}</th>
        <th></th>
      </tr>
    </thead>

    <tbody>

      {{#each actor.items as |item|}}
      {{#if (eq item.type "talent")}}

      <tr
  class="talent-row

  {{#if item.system.careerTemporary}}
    talent-temporary
  {{/if}}

  {{#if item.isAvailable}}
    talent-unpurchased
  {{/if}}

  {{#if item.isPurchased}}
    talent-purchased
  {{/if}}"
  data-item-id="{{item.id}}">

  <td>
    <div class="talent-name-line">
      <span class="talent-name">
        {{item.name}}
      </span>

     {{#if item.isCareerTalent}}
  <button
    class="talent-advance-btn"
    data-action="advanceTalent"
    data-item-id="{{item.id}}">
    +
  </button>
{{/if}}
    </div>
  </td>

  <td>
    <input
      type="number"
      data-action="updateTalentAdv"
      data-item-id="{{item.id}}"
      value="{{item.system.advances}}"
      min="0"
      max="{{#if (lookup ../system.attributes item.system.max)}}
        {{lookup (lookup ../system.attributes item.system.max) "bonus"}}
      {{else}}
        {{item.system.max}}
      {{/if}}"
      {{#unless ../user.isGM}}readonly{{/unless}}
    >
  </td>

  <td>
    {{#if (lookup ../system.attributes item.system.max)}}
      {{lookup (lookup ../system.attributes item.system.max) "bonus"}}
    {{else}}
      {{item.system.max}}
    {{/if}}
  </td>

  <td class="item-actions">
    <div class="actions-wrapper">
      <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
    </div>
  </td>

</tr>

<!-- 🔽 DESCRIPTION ROW -->
<tr class="talent-description" data-details="{{item.id}}" style="display: none;">
  <td colspan="4">
    {{item.system.description}}
  </td>
</tr>

      {{/if}}
      {{/each}}

    </tbody>

  </table>

</div>
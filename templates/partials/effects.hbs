<div class="tab-effects">

<h3>Conditions</h3>

<!-- 🔢 NUMERIC CONDITIONS -->
<table class="conditions-table numeric">
  <thead>
    <tr>
      {{#each system.conditions as |value key|}}
        {{#unless (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
          <th 
  class="condition-header"
  data-key="{{key}}"
  data-description="{{lookup (lookup ../config.conditionConfig key) 'description'}}"
>
  {{key}}
</th>
        {{/unless}}
      {{/each}}
    </tr>
  </thead>

<tbody>

  <!-- LIGNE VALEURS -->
  <tr>
    {{#each system.conditions as |value key|}}
      {{#unless (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
        <td 
          class="condition-cell"
          data-key="{{key}}"
        >
          <input type="number"
            class="condition-clickable"
            data-key="{{key}}"
            value="{{lookup ../system.conditionTotals key}}"
            min="0">
        </td>
      {{/unless}}
    {{/each}}
  </tr>

  <!-- 🔥 DÉPLIANT GLOBAL -->
  <tr class="condition-details-row" style="display:none;">
    <td colspan="100%" class="condition-details-content"></td>
  </tr>

</tbody>
</table>


<!-- ✅ BOOLEAN CONDITIONS -->
<table class="conditions-table boolean">
  <thead>
    <tr>
      {{#each system.conditions as |value key|}}
        {{#if (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
          <th 
  class="condition-header"
  data-key="{{key}}"
  data-description="{{lookup (lookup ../config.conditionConfig key) 'description'}}"
>
  {{key}}
</th>
        {{/if}}
      {{/each}}
    </tr>
  </thead>

<tbody>

  <!-- CHECKBOXES -->
  <tr>
    {{#each system.conditions as |value key|}}
      {{#if (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
        <td 
          class="condition-cell"
          data-key="{{key}}"
        >
          <input type="checkbox"
            name="system.conditions.{{key}}"
            data-action="updateConditionState"
            data-key="{{key}}"
            {{checked value}}>
        </td>
      {{/if}}
    {{/each}}
  </tr>

  <!-- 🔥 DÉPLIANT -->
  <tr class="condition-details-row" style="display:none;">
    <td colspan="100%" class="condition-details-content"></td>
  </tr>

</tbody>
</table>

  <!-- INJURIES -->
  <h3>Injuries</h3>

  <table class="injuries-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Severity</th>
        <th>Location</th>
        <th>Duration</th>
        <th></th>
      </tr>
    </thead>

    <tbody>
      {{#each actor.items as |item|}}
      {{#if (eq item.type "injury")}}

      <tr>

        <td>{{item.name}}</td>
        <td>{{item.system.severity}}</td>
        <td>{{item.system.location}}</td>
        <td>{{item.system.duration}}</td>

        <td class="item-actions">
          <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
          <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
        </td>

      </tr>

      {{/if}}
      {{/each}}
    </tbody>
  </table>


  <!-- TRAITS -->
  <h3>Traits</h3>

  <div class="effects-block">
    {{#each traits}}
      <div class="item">

        <span>{{this.name}}</span>

        <button data-action="editItem" data-item-id="{{this.id}}">Edit</button>
        <button data-action="deleteItem" data-item-id="{{this.id}}">Delete</button>

      </div>
    {{/each}}
  </div>


  <!-- DISEASES -->
  <h3>Diseases</h3>

  <div class="effects-block">
    {{#each diseases}}
      <div class="item">

        <span>{{this.name}}</span>

        <button data-action="editItem" data-item-id="{{this.id}}">Edit</button>
        <button data-action="deleteItem" data-item-id="{{this.id}}">Delete</button>

      </div>
    {{/each}}
  </div>

</div>
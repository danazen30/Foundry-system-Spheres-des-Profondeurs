<div class="tab-effects">

<h3>{{localize "SDP.Conditions"}}</h3>

<!-- 🔢 NUMERIC CONDITIONS -->
<table class="conditions-table numeric">
  <thead>
    <tr>
      {{#each system.conditions as |value key|}}
        {{#unless (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
          <th 
  class="condition-header"
  data-key="{{key}}"
  data-description="{{localize (lookup (lookup ../config.conditionConfig key) 'description')}}"
>
  {{localize (lookup (lookup ../config.conditionConfig key) "label")}}
</th>
        {{/unless}}
      {{/each}}
    </tr>
  </thead>

<tbody>

  <!-- LIGNE VALEURS -->
  <tr>
    {{#each system.conditions as |value key|}}
      {{#unless (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
        <td 
          class="condition-cell"
          data-key="{{key}}"
        >
          <input type="number"
            class="condition-clickable"
            data-key="{{key}}"
            value="{{lookup ../system.conditionTotals key}}"
            min="0">
        </td>
      {{/unless}}
    {{/each}}
  </tr>

  <!-- 🔥 DÉPLIANT GLOBAL -->
  <tr class="condition-details-row" style="display:none;">
    <td colspan="100%" class="condition-details-content"></td>
  </tr>

</tbody>
</table>


<!-- ✅ BOOLEAN CONDITIONS -->
<table class="conditions-table boolean">
  <thead>
    <tr>
      {{#each system.conditions as |value key|}}
        {{#if (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
          <th 
  class="condition-header"
  data-key="{{key}}"
  data-description="{{localize (lookup (lookup ../config.conditionConfig key) 'description')}}"
>
  {{localize (lookup (lookup ../config.conditionConfig key) "label")}}
</th>
        {{/if}}
      {{/each}}
    </tr>
  </thead>

<tbody>

  <!-- CHECKBOXES -->
  <tr>
    {{#each system.conditions as |value key|}}
      {{#if (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}
        <td 
          class="condition-cell"
          data-key="{{key}}"
        >
          <input type="checkbox"
            name="system.conditions.{{key}}"
            data-action="updateConditionState"
            data-key="{{key}}"
            {{checked value}}>
        </td>
      {{/if}}
    {{/each}}
  </tr>

  <!-- 🔥 DÉPLIANT -->
  <tr class="condition-details-row" style="display:none;">
    <td colspan="100%" class="condition-details-content"></td>
  </tr>

</tbody>
</table>

  <!-- INJURIES -->
  {{#if injuries.length}}
<h3>{{localize "SDP.Injuries"}}</h3>

<table class="effects-table">
  <thead>
    <tr>
      <th></th>
      <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.Severity"}}</th>
<th>{{localize "SDP.Location"}}</th>
<th>{{localize "SDP.Duration"}}</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    {{#each actor.items as |item|}}
    {{#if (eq item.type "injury")}}

    <tr>
      <!-- IMAGE -->
      <td class="effect-img-cell">
        <img src="{{item.img}}" class="effect-img">
      </td>

      <td>{{item.displayName}}</td>
      <td>{{item.system.severity}}</td>
      <td>{{item.system.location}}</td>
      <td>{{item.system.duration}}</td>

      <td class="item-actions">
        <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
        <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
      </td>
    </tr>

    {{/if}}
    {{/each}}
  </tbody>
</table>
{{/if}}

<!-- TRAITS -->
{{#if traits.length}}
<h3>{{localize "SDP.Traits"}}</h3>

<table class="effects-table">
  <thead>
    <tr>
      <th></th>
      <th>{{localize "SDP.Name"}}</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    {{#each traits}}
    <tr>

      <td class="effect-img-cell">
        <img src="{{this.img}}" class="effect-img">
      </td>

      <td>{{this.displayName}}</td>

      <td class="item-actions">
        <button data-action="editItem" data-item-id="{{this.id}}">✏️</button>
        <button data-action="deleteItem" data-item-id="{{this.id}}">🗑️</button>
      </td>

    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}


<!-- DISEASES -->
{{#if diseases.length}}
<h3>{{localize "SDP.Diseases"}}</h3>

<table class="effects-table">
  <thead>
    <tr>
      <th></th>
      <th>{{localize "SDP.Name"}}</th>
      <th></th>
    </tr>
  </thead>

  <tbody>
    {{#each diseases}}
    <tr>

      <td class="effect-img-cell">
        <img src="{{this.img}}" class="effect-img">
      </td>

      <td>{{this.displayName}}</td>

      <td class="item-actions">
        <button data-action="editItem" data-item-id="{{this.id}}">✏️</button>
        <button data-action="deleteItem" data-item-id="{{this.id}}">🗑️</button>
      </td>

    </tr>
    {{/each}}
  </tbody>
</table>
{{/if}}

</div>
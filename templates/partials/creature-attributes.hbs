<table class="creature-attributes-table">

  <thead>
    <tr>

      {{#each attributes as |attr|}}

        <th
          class="creature-attr-roll"
          data-action="rollAttribute"
          data-attr="{{attr.key}}"
        >
          {{attr.label}}
        </th>

      {{/each}}

    </tr>
  </thead>

  <tbody>
    <tr>

      {{#each attributes as |attr|}}

        <td>

          <input
            type="number"
            class="attr-initial-input"
            data-key="{{attr.key}}"
            value="{{attr.initial}}">

        </td>

      {{/each}}

    </tr>
  </tbody>

</table>
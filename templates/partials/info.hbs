<div class="tab-info">

  <!-- DETAILS -->
<h3>{{localize "SDP.Details"}}</h3>

  <div class="details">

  <!-- PHYSICAL -->
  <div class="details-group">
    <h4>{{localize "SDP.Physical"}}</h4>

    <div class="details-grid">

      <div class="resource-row">
        <label>{{localize "SDP.Age"}}</label>
        <input type="text" name="system.details.age.value" value="{{system.details.age.value}}">
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Height"}}</label>
        <input type="text" name="system.details.height.value" value="{{system.details.height.value}}">
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Weight"}}</label>
        <input type="text" name="system.details.weight.value" value="{{system.details.weight.value}}">
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Hair"}}</label>
        <input type="text" name="system.details.hairColor.value" value="{{system.details.hairColor.value}}">
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Eyes"}}</label>
        <input type="text" name="system.details.eyeColor.value" value="{{system.details.eyeColor.value}}">
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Mark"}}</label>
        <input type="text" name="system.details.distinguishingMark.value" value="{{system.details.distinguishingMark.value}}">
      </div>

    </div>

<div class="resource-row">
  <label>{{localize "SDP.Size"}}</label>

  <select name="system.details.size.value">

    {{#each config.sizes as |size key|}}

      <option
        value="{{key}}"
        {{#if (eq @root.system.details.size.value key)}}selected{{/if}}>

        {{localize size.label}}

      </option>

    {{/each}}

  </select>
</div>

  </div>


  <!-- ORIGIN -->
  <div class="details-group">
    <h4>{{localize "SDP.Origin"}}</h4>

    <div class="details-grid">

      <div class="resource-row">
        <label>{{localize "SDP.Species"}}</label>
        {{#if species}}
          <span>{{species.name}}</span>
        {{else}}
          <span>{{localize "SDP.None"}}</span>
        {{/if}}
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Sign"}}</label>
        {{#if sign}}
          <span>{{sign.name}}</span>
        {{else}}
          <span>{{localize "SDP.NoSign"}}</span>
        {{/if}}
      </div>

      <div class="resource-row">
        <label>{{localize "SDP.Ascendant"}}</label>
        <input type="text" name="system.details.ascending.value" value="{{system.details.ascending.value}}">
      </div>

    </div>
  </div>


  <!-- STATUS -->
  <div class="details-group">
    <h4>{{localize "SDP.Status"}}</h4>

    <div class="details-grid">

      <div class="resource-row">
        <label>{{localize "SDP.Career"}}</label>
        <textarea name="system.details.career.value">{{system.details.career.value}}</textarea>
      </div>

      <div class="resource-row">
  <label>{{localize "SDP.CareerGroup"}}</label>
  <textarea name="system.details.careerGroup.value">{{system.details.careerGroup.value}}</textarea>
</div>

      <div class="resource-row">
        <label>{{localize "SDP.Standing"}}</label>
        <input type="text" name="system.details.standing.value" value="{{system.details.standing.value}}">
      </div>

    </div>
  </div>

</div>

{{#unless isLimitedObserver}}
  <!-- CAREERS -->
  <table class="careers-table">

    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Careers"}}</th>
        <th>{{localize "SDP.Current"}}</th>
        <th>{{localize "SDP.Completed"}}</th>
        <th></th>
      </tr>
    </thead>

    <tbody>

      {{#each actor.items as |item|}}
      {{#if (eq item.type "career")}}

      <tr>

        <td class="career-img-cell">
    <img src="{{item.img}}" alt="{{item.displayName}}">
  </td>

        <td>{{item.displayName}}</td>

        <td>
          <input type="checkbox"
            data-action="toggleCareerCurrent"
            data-item-id="{{item.id}}"
            {{checked item.system.current}}>
        </td>

        <td>
          <input type="checkbox"
            data-action="toggleCareerCompleted"
            data-item-id="{{item.id}}"
            {{checked item.system.completed}}>
        </td>

        <td class="item-actions">
          <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
          <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
        </td>

      </tr>

      {{/if}}
      {{/each}}

    </tbody>

  </table>

  <div class="resource-row">

  <label>{{localize "SDP.Work"}}</label>

  <button
    type="button"
    data-action="workCareer">

    {{localize "SDP.Work"}}

  </button>

</div>

  <!-- EXPERIENCE -->
  {{#unless isNPC}}
  <h3>{{localize "SDP.Experience"}}</h3>

  <div class="xp-container">

    <div class="xp-summary">

  <div class="xp-cell">
    <label>{{localize "SDP.Total"}}</label>
    <input
      type="number"
      value="{{xp.total}}"
      data-action="updateXP"
      data-type="total"
      {{#unless user.isGM}}readonly{{/unless}}>
  </div>

  <div class="xp-cell">
    <label>{{localize "SDP.Spent"}}</label>
    <input
      type="number"
      value="{{xp.spent}}"
      data-action="updateXP"
      data-type="spent"
      {{#unless user.isGM}}readonly{{/unless}}>
  </div>

  <div class="xp-cell">
    <label>{{localize "SDP.Available"}}</label>
    <input
      type="number"
      value="{{xp.available}}"
      readonly>
  </div>

</div>

    <div class="xp-bar">

      <div class="xp-label">
        XP: {{xpBar.value}}
        {{#if xpBar.nextXP}}
          / {{xpBar.nextXP}}
        {{else}}
          ({{localize "SDP.Max"}})
        {{/if}}
      </div>

      <div class="xp-bar-bg">
        <div class="xp-bar-fill" style="width: {{xpBar.percent}}%;"></div>
      </div>

    </div>
    {{/unless}}

      <div class="level-progression">

    {{#if levelProgression.length}}
      <ul>
        {{#each levelProgression}}
          <li class="level-entry">

  <div class="level-main">
    <strong>{{localize "SDP.Level"}} {{this.level}}</strong>

    <div class="level-stats">
      {{#if this.hp}}
        <span class="lvl-stat hp">
  +{{this.hp}} {{localize "SDP.HP"}}
</span>
      {{/if}}

      {{#if this.damageBonus}}
        <span class="lvl-stat dmg">
  +{{this.damageBonus}} {{localize "SDP.DMG"}}
</span>
      {{/if}}

      {{#if this.inspirationDice}}
       <span class="lvl-stat insp">
  +{{this.inspirationDice}} {{localize "SDP.Inspiration"}}
</span>
      {{/if}}

      {{#if this.hpRoll}}
  <span class="lvl-stat dice">
    +{{this.hpRoll}} {{localize "SDP.HP"}} ({{this.hitDice}})
  </span>
{{/if}}
    </div>
  </div>

  {{#if this.description}}
    <p class="level-desc">{{this.description}}</p>
  {{/if}}

</li>
        {{/each}}
      </ul>
    {{else}}
      <p>{{localize "SDP.NoLevelProgression"}}</p>
    {{/if}}

  </div>

  </div>
{{/unless}}

  {{#if canLevelUp}}
    <div class="level-up">
      <button data-action="levelUp">
        {{localize "SDP.LevelUpAvailable"}} → {{availableLevel}}
      </button>
    </div>
  {{/if}}

{{#unless isNPC}}
<div class="ambitions">

  <!-- PERSONAL -->
  <h4>{{localize "SDP.PersonalAmbitions"}}</h4>

  <div class="resource-row">
    <label>{{localize "SDP.ShortTerm"}}</label>
    <input type="text" name="system.details.personalAmbitions.shortTerm"
           value="{{system.details.personalAmbitions.shortTerm}}">
  </div>

  <div class="resource-row">
    <label>{{localize "SDP.LongTerm"}}</label>
    <input type="text" name="system.details.personalAmbitions.longTerm"
           value="{{system.details.personalAmbitions.longTerm}}">
  </div>

  <!-- PARTY -->
  <h4>{{localize "SDP.GroupAmbitions"}}</h4>

  <div class="resource-row">
    <label>{{localize "SDP.Name"}}</label>
    <input type="text" name="system.details.partyAmbitions.name"
           value="{{system.details.partyAmbitions.name}}">
  </div>

  <div class="resource-row">
    <label>{{localize "SDP.ShortTerm"}}</label>
    <input type="text" name="system.details.partyAmbitions.shortTerm"
           value="{{system.details.partyAmbitions.shortTerm}}">
  </div>

  <div class="resource-row">
    <label>{{localize "SDP.LongTerm"}}</label>
    <input type="text" name="system.details.partyAmbitions.longTerm"
           value="{{system.details.partyAmbitions.longTerm}}">
  </div>

  <!-- MOTIVATION -->
  <div class="resource-row">
    <label>{{localize "SDP.Motivation"}}</label>
    <input type="text" name="system.details.motivation.value"
           value="{{system.details.motivation.value}}">
  </div>

</div>
{{/unless}}

<h3>{{localize "SDP.NotesBackground"}}</h3>

<div class="notes-section">

{{#if isNPC}}

<div class="resource-block note-block shared-journal-drop">

  <div class="note-header">

    <label>{{localize "SDP.SharedNpcNotes"}}</label>

    <div class="note-actions">

      {{#if canEditPlayerNotes}}
      <button
        type="button"
        class="note-edit-btn"
        data-action="toggleEditor"
        data-target="sharedNpcNotes">

        ✏️ {{localize "SDP.Edit"}}

      </button>
      {{/if}}

      {{#if sharedJournal}}
      <button
        type="button"
        class="note-edit-btn"
        data-action="unlinkSharedJournal">

        ❌

      </button>
      {{/if}}

    </div>

  </div>

  {{#if sharedJournal}}

    <p>
      {{localize "SDP.LinkedJournal"}}:
      <strong>
  {{sharedJournal.name}}
  →
  {{sharedJournalPage.name}}
</strong>
    </p>

    <div class="resource-block note-block">

  <!-- DISPLAY -->
  <div
    class="note-display"
    data-display="sharedNpcNotes">

    {{{editors.sharedNpcNotes}}}

  </div>

  <!-- EDITOR -->
{{#if canEditPlayerNotes}}
<div
  class="note-editor"
  data-editor="sharedNpcNotes"
  style="display:none;">

  <prose-mirror
    name="sharedNpcNotes"
    value="{{sharedNpcNotes}}">

    {{{sharedNpcNotes}}}

  </prose-mirror>

</div>
{{/if}}

</div>

  {{else}}

    <div class="empty-drop-zone">

      {{localize "SDP.DropJournalHere"}}

    </div>

  {{/if}}

</div>

{{/if}}

{{#unless isLimitedObserver}}
<div class="resource-block note-block">

  <div class="note-header">
    <label>{{localize "SDP.Biography"}}</label>

    <button
      type="button"
      class="note-edit-btn"
      data-action="toggleEditor"
      data-target="biography">
      ✏️ {{localize "SDP.Edit"}}
    </button>
  </div>

  <!-- DISPLAY -->
  <div class="note-display" data-display="biography">
    {{{system.details.biography.value}}}
  </div>

  <!-- EDITOR -->
  <div
    class="note-editor"
    data-editor="biography"
    style="display:none;">

    <prose-mirror
  name="system.details.biography.value"
  value="{{system.details.biography.value}}">
  {{{system.details.biography.value}}}
</prose-mirror>

  </div>

</div>
{{/unless}}
{{#unless isNPC}}
<div class="resource-block note-block">

  <div class="note-header">
    <label>{{localize "SDP.PlayerNotes"}}</label>

    {{#if canEditPlayerNotes}}
    <button
      type="button"
      class="note-edit-btn"
      data-action="toggleEditor"
      data-target="playerNotes">
      ✏️ {{localize "SDP.Edit"}}
    </button>
    {{/if}}

  </div>

  <!-- DISPLAY -->
  <div class="note-display" data-display="playerNotes">
    {{{system.details.playerNotes.value}}}
  </div>

  <!-- EDITOR -->
  <div
    class="note-editor"
    data-editor="playerNotes"
    style="display:none;">

    <prose-mirror
  name="system.details.playerNotes.value"
  value="{{system.details.playerNotes.value}}">
  {{{system.details.playerNotes.value}}}
</prose-mirror>

  </div>

</div>
{{/unless}}
{{#if user.isGM}}
<div class="resource-block note-block">

  <div class="note-header">
    <label>{{localize "SDP.GMNotes"}}</label>

    <button
      type="button"
      class="note-edit-btn"
      data-action="toggleEditor"
      data-target="gmNotes">
      ✏️ {{localize "SDP.Edit"}}
    </button>
  </div>

  <!-- DISPLAY -->
  <div class="note-display" data-display="gmNotes">
    {{{system.details.gmNotes.value}}}
  </div>

  <!-- EDITOR -->
  <div
    class="note-editor"
    data-editor="gmNotes"
    style="display:none;">

    <prose-mirror
  name="system.details.gmNotes.value"
  value="{{system.details.gmNotes.value}}">
  {{{system.details.gmNotes.value}}}
</prose-mirror>

  </div>

</div>

  {{/if}}
{{#unless isNPC}}
  <!-- XP LOG -->
  <h3>{{localize "SDP.XPLogTitle"}}</h3>

  <ul class="xp-log">

    {{#if xp.log.length}}
      {{#each xp.log}}
        <li class="xp-entry">
          {{this.label}}
        </li>
      {{/each}}
    {{else}}
      <li>{{localize "SDP.NoXPActivity"}}</li>
    {{/if}}

  </ul>
{{/unless}}

</div>
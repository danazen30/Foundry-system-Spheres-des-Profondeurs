<div class="skills-container">

  <!-- 🔹 BASE SKILLS -->
  <div class="skills-block">
    <h3>Basic Skills</h3>

    <table class="skills-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Char</th>
          <th>Adv</th>
          <th>Value</th>
          <th></th>
        </tr>
      </thead>

      <tbody>

        {{#each actor.items as |item|}}
        {{#if (eq item.type "skill")}}
        {{#unless item.system.advanced}}

        <tr>
          <td>{{item.name}}</td>

          <td>{{item.system.characteristic}}</td>

          <td>
            <input type="number"
                   value="{{item.system.advances}}"
                   data-action="updateSkillAdv"
                   data-item-id="{{item.id}}">
          </td>

          <td class="roll-skill"
              data-action="rollSkill"
              data-item-id="{{item.id}}">
            {{item.system.value}}
          </td>

          <td class="item-actions">
            <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
            <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
          </td>
        </tr>

        {{/unless}}
        {{/if}}
        {{/each}}

      </tbody>
    </table>
  </div>

  <!-- 🔸 ADVANCED SKILLS -->
  <div class="skills-block">
    <h3>Advanced Skills</h3>

    <table class="skills-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Char</th>
          <th>Adv</th>
          <th>Value</th>
          <th></th>
        </tr>
      </thead>

      <tbody>

        {{#each actor.items as |item|}}
        {{#if (eq item.type "skill")}}
        {{#if item.system.advanced}}

        <tr>
          <td>{{item.name}}</td>

          <td>{{item.system.characteristic}}</td>

          <td>
            <input type="number"
                   value="{{item.system.advances}}"
                   data-action="updateSkillAdv"
                   data-item-id="{{item.id}}">
          </td>

          <td class="roll-skill"
              data-action="rollSkill"
              data-item-id="{{item.id}}">
            {{item.system.value}}
          </td>

          <td class="item-actions">
            <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
            <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
          </td>
        </tr>

        {{/if}}
        {{/if}}
        {{/each}}

      </tbody>
    </table>
  </div>

</div>
<div class="skills-container">

  <!-- 🔹 BASE SKILLS -->
  <div class="skills-block">
    <h3>{{localize "SDP.BasicSkills"}}</h3>

    <div class="skills-table-wrapper">

      <table class="skills-table">
        <thead>
          <tr>
            <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.CharAbbr"}}</th>
<th>{{localize "SDP.AdvancesAbbr"}}</th>
<th>{{localize "SDP.Value"}}</th>
            <th></th>
          </tr>
        </thead>

        <tbody>

          {{#each actor.items as |item|}}
          {{#if (eq item.type "skill")}}
          {{#unless item.system.advanced}}

          <tr>

            <!-- 🔥 NAME + CAREER BUTTON -->
            <td class="skill-name-cell">
  <div class="skill-name-inner">
    <span class="roll-skill-name"
      data-action="rollSkill"
      data-item-id="{{item.id}}">
  {{item.displayName}}
</span>

    {{#if ../currentCareer}}
      {{#if item.isCareerSkill}}
        <button
          class="skill-advance-btn"
          data-action="advanceSkill"
          data-item-id="{{item.id}}">
          
          {{#if (gte item.system.advances (multiply ../currentCareer.system.level 5))}}
            ✔
          {{else}}
            +
          {{/if}}

        </button>
      {{/if}}
    {{/if}}

  </div>
</td>

            <!-- CHAR -->
            <td>
              {{localizeAttributeAbbr item.system.characteristic}}
            </td>

            <!-- ADV -->
            <td>
              <input type="number"
                     value="{{item.system.advances}}"
                     data-action="updateSkillAdv"
                     data-item-id="{{item.id}}">
            </td>

            <!-- VALUE -->
            <td class="roll-skill"
                data-action="rollSkill"
                data-item-id="{{item.id}}">
              {{item.system.value}}
            </td>

            <!-- ACTIONS -->
            <td class="item-actions">
              <div class="actions-wrapper">
                <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
              </div>
            </td>

          </tr>

          {{/unless}}
          {{/if}}
          {{/each}}

        </tbody>
      </table>

    </div>
  </div>

  <!-- 🔸 ADVANCED SKILLS -->
  <div class="skills-block">
    <h3>{{localize "SDP.AdvancedSkills"}}</h3>

    <div class="skills-table-wrapper">

      <table class="skills-table">
        <thead>
          <tr>
            <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.CharAbbr"}}</th>
<th>{{localize "SDP.AdvancesAbbr"}}</th>
<th>{{localize "SDP.Value"}}</th>
            <th></th>
          </tr>
        </thead>

        <tbody>

          {{#each actor.items as |item|}}
          {{#if (eq item.type "skill")}}
          {{#if item.system.advanced}}

          <tr>

            <!-- 🔥 NAME + CAREER BUTTON -->
            <td class="skill-name-cell">

              <span class="roll-skill-name"
      data-action="rollSkill"
      data-item-id="{{item.id}}">
  {{item.displayName}}
</span>

              {{#if ../currentCareer}}
                {{#if item.isCareerSkill}}
                  <button
                    class="skill-advance-btn"
                    data-action="advanceSkill"
                    data-item-id="{{item.id}}"
                    title="{{localize 'SDP.AdvanceCostXP'}}">

                    {{#if (gte item.system.advances (multiply ../currentCareer.system.level 5))}}
                      ✔
                    {{else}}
                      +
                    {{/if}}

                  </button>
                {{/if}}
              {{/if}}

            </td>

            <!-- CHAR -->
            <td>
              {{localizeAttributeAbbr item.system.characteristic}}
            </td>

            <!-- ADV -->
            <td>
              <input type="number"
                     value="{{item.system.advances}}"
                     data-action="updateSkillAdv"
                     data-item-id="{{item.id}}">
            </td>

            <!-- VALUE -->
            <td class="roll-skill"
                data-action="rollSkill"
                data-item-id="{{item.id}}">
              {{item.system.value}}
            </td>

            <!-- ACTIONS -->
            <td class="item-actions">
              <div class="actions-wrapper">
                <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
              </div>
            </td>

          </tr>

          {{/if}}
          {{/if}}
          {{/each}}

        </tbody>
      </table>

    </div>
  </div>

</div>
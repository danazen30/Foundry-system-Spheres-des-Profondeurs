<div class="tab-magic">

  <!-- MINOR SPELLS -->
  <h3>Minor Spells</h3>

  <table class="spells-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Mana</th>
        <th>Mem</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      {{#each spellsMinor as |spell|}}
      <tr>

        <td>{{spell.name}}</td>

        <td>
          {{#if spell.system.memorized.value}}
            {{spell.system.power.value}}
          {{else}}
            {{multiply spell.system.power.value 2}}
          {{/if}}
        </td>

        <td>
          <input type="checkbox"
            data-action="toggleSpellMemory"
            data-item-id="{{spell.id}}"
            {{checked spell.system.memorized.value}}>
        </td>

        <td class="item-actions">
          <button data-action="castSpell" data-item-id="{{spell.id}}">Cast</button>
          <button data-action="editItem" data-item-id="{{spell.id}}">✏️</button>
          <button data-action="deleteItem" data-item-id="{{spell.id}}">🗑️</button>
        </td>

      </tr>
      {{/each}}
    </tbody>
  </table>



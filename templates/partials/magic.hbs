<div class="tab-magic">

  {{#if (eq actor.type "creature")}}

  {{#if passiveAbilities.length}}
  <!-- PASSIVE ABILITIES -->
  <h3>{{localize "SDP.PassiveAbilities"}}</h3>

  <table class="spells-table abilities-table passive-abilities-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Name"}}</th>
        <th>{{localize "SDP.Actions"}}</th>
      </tr>
    </thead>

    <tbody>
      {{#each passiveAbilities as |ability|}}
<tr class="spell-row ability-row" data-item-id="{{ability.id}}">

  <td class="spell-img-cell">
  <img src="{{ability.img}}" title="{{ability.displayName}}">
</td>

  <td
    class="spell-name ability-toggle"
    data-action="toggleAbilityDetails"
    data-item-id="{{ability.id}}"
  >
    {{ability.displayName}}
  </td>

  <td class="item-actions">
    <button data-action="editItem" data-item-id="{{ability.id}}">✏️</button>
    <button data-action="deleteItem" data-item-id="{{ability.id}}">🗑️</button>
  </td>

</tr>

{{> "systems/sdp/templates/partials/spell-details.hbs" item=ability colspan=3}}

  {{/each}}
</tbody>
  </table>
  {{/if}}

  {{#if activeAbilities.length}}
  <!-- ACTIVE ABILITIES -->
  <h3>{{localize "SDP.ActiveAbilities"}}</h3>

  <table class="spells-table abilities-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Name"}}</th>
        <th>{{localize "SDP.Mana"}}</th>
        <th>{{localize "SDP.Actions"}}</th>
      </tr>
    </thead>

    <tbody>
      {{#each activeAbilities as |ability|}}
<tr class="spell-row ability-row" data-item-id="{{ability.id}}">

  <td class="spell-img-cell">
  <img src="{{ability.img}}" title="{{ability.displayName}}">
</td>

  <td
    class="spell-name roll-ability-name"
    data-action="useAbility"
    data-item-id="{{ability.id}}"
  >
    {{ability.displayName}}
  </td>

  <td>
    {{ability.system.power.value}}
  </td>

  <td class="item-actions">
    <button data-action="editItem" data-item-id="{{ability.id}}">✏️</button>
    <button data-action="deleteItem" data-item-id="{{ability.id}}">🗑️</button>
  </td>

</tr>

{{> "systems/sdp/templates/partials/spell-details.hbs" item=ability colspan=4}}

  {{/each}}
</tbody>
  </table>
  {{/if}}

  {{/if}}

  <!-- MINOR SPELLS -->
  <h3>{{localize "SDP.MinorSpells"}}</h3>

  <table class="spells-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.Mana"}}</th>
<th>{{localize "SDP.Memory"}}</th>
<th>{{localize "SDP.Actions"}}</th>
      </tr>
    </thead>

    <tbody>
      {{#each spellsMinor}}
        {{> "systems/sdp/templates/partials/spell-row.hbs"}}
      {{/each}}
    </tbody>
  </table>


  <!-- ADVANCED SPELLS -->
  <h3>{{localize "SDP.AdvancedSpells"}}</h3>

  <table class="spells-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.Mana"}}</th>
<th>{{localize "SDP.Memory"}}</th>
<th>{{localize "SDP.Actions"}}</th>
      </tr>
    </thead>

<tbody>
  {{#each spellsAdvanced}}
    {{> "systems/sdp/templates/partials/spell-row.hbs"}}
  {{/each}}
</tbody>
  </table>


  <!-- SUPERIOR SPELLS -->
  <h3>{{localize "SDP.SuperiorSpells"}}</h3>

  <table class="spells-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.Mana"}}</th>
<th>{{localize "SDP.Memory"}}</th>
<th>{{localize "SDP.Actions"}}</th>
      </tr>
    </thead>

    <tbody>
  {{#each spellsSuperior}}
    {{> "systems/sdp/templates/partials/spell-row.hbs"}}
  {{/each}}
</tbody>
  </table>

</div>

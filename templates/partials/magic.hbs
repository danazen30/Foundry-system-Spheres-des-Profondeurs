<div class="tab-magic">

  <!-- MINOR SPELLS -->
  <h3>{{localize "SDP.MinorSpells"}}</h3>

  <table class="spells-table">
    <thead>
      <tr>
        <th></th>
        <th>{{localize "SDP.Name"}}</th>
<th>{{localize "SDP.Mana"}}</th>
<th>{{localize "SDP.Memory"}}</th>
<th>{{localize "SDP.Actions"}}</th>
      </tr>
    </thead>

    <tbody>
      {{#each spellsMinor as |spell|}}
<tr class="spell-row" data-item-id="{{spell.id}}">

  <td class="spell-img-cell">
  <img src="{{spell.img}}" title="{{spell.name}}">
</td>

  <td 
    class="spell-name roll-spell-name" 
    data-action="rollSpell"
    data-item-id="{{spell.id}}"
  >
    {{spell.name}}
  </td>

  <td>
    {{#if spell.system.memorized.value}}
      {{spell.system.power.value}}
    {{else}}
      {{multiply spell.system.power.value 2}}
    {{/if}}
  </td>

  <td>
    <input type="checkbox"
      data-action="toggleSpellMemory"
      data-item-id="{{spell.id}}"
      {{checked spell.system.memorized.value}}>
  </td>

  <td class="item-actions">
    <button data-action="editItem" data-item-id="{{spell.id}}">✏️</button>
    <button data-action="deleteItem" data-item-id="{{spell.id}}">🗑️</button>
  </td>

</tr>

<!-- 🔽 DEPLIANT -->
<tr class="spell-details" data-details="{{spell.id}}" style="display:none;">
  <td colspan="5">

    <div class="spell-detail-box">

  <p><strong>Magic:</strong> {{spell.system.magic.value}}</p>
  <p><strong>Range:</strong> {{spell.system.range.value}}</p>

  <!-- ========================= -->
  <!-- DURATION -->
  <!-- ========================= -->
  <p>
  <strong>Duration:</strong>
  {{#if spell.system.concentration.value}}
    Concentration
  {{else}}
    {{spell.system.duration.value}}
    {{spell.system.duration.type}}
    {{#if spell.system.duration.extendable}} (Extendable){{/if}}
  {{/if}}
</p>

  <!-- ========================= -->
  <!-- TARGET -->
  <!-- ========================= -->
  <p>
  <strong>Target:</strong>
  {{#if spell.system.aoe.value}}
    Area of Effect (Radius: {{spell.system.radius.value}})
  {{else}}
    {{spell.system.target.value}} target(s)
  {{/if}}
</p>

  <!-- ========================= -->
  <!-- DAMAGE -->
  <!-- ========================= -->
  <p><strong>Damage:</strong>
    {{spell.system.damage.base.value}}
    {{spell.system.damage.dice.value}}
  </p>

  <!-- ========================= -->
  <!-- OVERCAST SPECIAL -->
  <!-- ========================= -->
{{#each spell.system.overcastSpecialEffects.value as |effect|}}
  {{#if @first}}
    <div class="overcast-line">
      <strong>Overcast Special:</strong>
      <ul>
  {{/if}}

  <li>
    <strong>{{effect.label}}</strong> : {{effect.value}}
  </li>

  {{#if @last}}
      </ul>
    </div>
  {{/if}}
{{/each}}

  <!-- ========================= -->
  <!-- DESCRIPTION -->
  <!-- ========================= -->
  <p class="spell-description">
  {{spell.system.description}}
</p>

</div>

  </td>
</tr>
      {{/each}}
    </tbody>
  </table>



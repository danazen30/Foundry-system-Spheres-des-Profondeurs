<div class="creature-info-grid">

  <!-- LEFT -->
  <div class="creature-info-left">

    <!-- SIZE -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        📏 {{localize "SDP.Size"}}
      </div>

      <div class="creature-size-value">

        <select name="system.size">

          {{#each config.sizes as |size key|}}

            <option
              value="{{key}}"
              {{#if (eq ../system.size key)}}selected{{/if}}>

              {{localize size.label}}

            </option>

          {{/each}}

        </select>

      </div>

    </div>

    <!-- TRAITS -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        🧬 {{localize "SDP.Traits"}}
      </div>

      <div class="creature-traits-list">

        {{#if actor.itemTypes.trait.length}}

          {{#each actor.itemTypes.trait}}

            <div class="creature-trait-row">
              {{this.name}}
            </div>

          {{/each}}

        {{else}}

          <div class="creature-empty">
            {{localize "SDP.NoTraits"}}
          </div>

        {{/if}}

      </div>

    </div>

    <!-- DEFENSE MODE -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        🛡️ {{localize "SDP.Defense"}}
      </div>

      <div class="creature-size-value">

        <select name="system.combat.defenseMode">

          <option
            value="auto"
            {{#if (eq system.combat.defenseMode "auto")}}
              selected
            {{/if}}>

            {{localize "SDP.Auto"}}

          </option>

          <option
            value="evasion"
            {{#if (eq system.combat.defenseMode "evasion")}}
              selected
            {{/if}}>

            {{localize "SDP.EvasionOnly"}}

          </option>

          <option
            value="parry"
            {{#if (eq system.combat.defenseMode "parry")}}
              selected
            {{/if}}>

            {{localize "SDP.ParryOnly"}}

          </option>

        </select>

      </div>

    </div>

  </div>

  <!-- RIGHT -->
  <div class="creature-info-right">

    <!-- PLAYER NOTES -->
    <div class="creature-info-card">

      <div class="note-header">

        <label>📖 {{localize "SDP.PlayerNotes"}}</label>

        {{#if canEditPlayerNotes}}
        <button
          type="button"
          class="note-edit-btn"
          data-action="toggleEditor"
          data-target="creaturePlayerNotes">

          ✏️ {{localize "SDP.Edit"}}

        </button>
        {{/if}}

      </div>

      <!-- DISPLAY -->
      <div
        class="creature-note-display"
        data-display="creaturePlayerNotes">

        {{{system.details.playerNotes.value}}}

      </div>

      <!-- EDITOR -->
      <div
        class="creature-note-editor"
        data-editor="creaturePlayerNotes"
        style="display:none;">

        <prose-mirror
          name="system.details.playerNotes.value"
          value="{{system.details.playerNotes.value}}">

          {{{system.details.playerNotes.value}}}

        </prose-mirror>

      </div>

    </div>

    {{#if user.isGM}}
    <!-- GM NOTES -->
    <div class="creature-info-card">

      <div class="note-header">

        <label>🔒 {{localize "SDP.GMNotes"}}</label>

        <button
          type="button"
          class="note-edit-btn"
          data-action="toggleEditor"
          data-target="creatureGMNotes">

          ✏️ {{localize "SDP.Edit"}}

        </button>

      </div>

      <!-- DISPLAY -->
      <div
        class="creature-note-display"
        data-display="creatureGMNotes">

        {{{system.details.gmNotes.value}}}

      </div>

      <!-- EDITOR -->
      <div
        class="creature-note-editor"
        data-editor="creatureGMNotes"
        style="display:none;">

        <prose-mirror
          name="system.details.gmNotes.value"
          value="{{system.details.gmNotes.value}}">

          {{{system.details.gmNotes.value}}}

        </prose-mirror>

      </div>

    </div>

    {{/if}}

  </div>

</div>
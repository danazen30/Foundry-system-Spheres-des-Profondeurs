<div class="creature-info-grid">

  <!-- LEFT -->
  <div class="creature-info-left">

    {{#if user.isGM}}
    <!-- KEY -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        {{localize "SDP.Key"}}
      </div>

      <div class="creature-size-value">
        <input
          type="text"
          name="system.key"
          value="{{system.key}}"
          placeholder="morak"
        >
      </div>

    </div>
    {{/if}}

    <!-- SIZE -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        📏 {{localize "SDP.Size"}}
      </div>

      <div class="creature-size-value">

        <select name="system.details.size.value">

          {{#each config.sizes as |size key|}}

            <option
              value="{{key}}"
              {{#if (eq @root.system.details.size.value key)}}selected{{/if}}>

              {{localize size.label}}

            </option>

          {{/each}}

        </select>

      </div>

    </div>

    <!-- DEFENSE MODE -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        🛡️ {{localize "SDP.Defense"}}
      </div>

      <div class="creature-size-value">

        <select name="system.combat.defenseMode">

          <option
            value="auto"
            {{#if (eq system.combat.defenseMode "auto")}}
              selected
            {{/if}}>

            {{localize "SDP.Auto"}}

          </option>

          <option
            value="evasion"
            {{#if (eq system.combat.defenseMode "evasion")}}
              selected
            {{/if}}>

            {{localize "SDP.EvasionOnly"}}

          </option>

          <option
            value="parry"
            {{#if (eq system.combat.defenseMode "parry")}}
              selected
            {{/if}}>

            {{localize "SDP.ParryOnly"}}

          </option>

        </select>

      </div>

    </div>

    <!-- TRAITS -->
    <div class="creature-info-card">

      <div class="creature-info-title">
        🧬 {{localize "SDP.Traits"}}
      </div>

      <div class="creature-traits-list">

        {{#if actor.itemTypes.trait.length}}

          {{#each actor.itemTypes.trait}}

            <div class="creature-trait-row" data-item-id="{{this.id}}">
              <span class="creature-trait-name">{{this.displayName}}</span>
              <div class="creature-trait-actions">
                {{#if this.isToggleableTrait}}
                <button
                  type="button"
                  class="creature-trait-toggle {{#if this.system.active}}is-active{{/if}}"
                  data-action="toggleTraitActive"
                  data-item-id="{{this.id}}"
                  title="{{#if this.system.active}}{{localize "SDP.TraitActive"}}{{else}}{{localize "SDP.TraitInactive"}}{{/if}}">
                  {{#if this.system.active}}●{{else}}○{{/if}}
                </button>
                {{/if}}
                <button
                  type="button"
                  class="creature-trait-edit"
                  data-action="editItem"
                  data-item-id="{{this.id}}"
                  title="{{localize "SDP.Edit"}}">
                  ✏️
                </button>
                <button
                  type="button"
                  class="creature-trait-delete"
                  data-action="deleteItem"
                  data-item-id="{{this.id}}"
                  title="{{localize "SDP.Delete"}}">
                  🗑️
                </button>
              </div>
            </div>

          {{/each}}

        {{else}}

          <div class="creature-empty">
            {{localize "SDP.NoTraits"}}
          </div>

        {{/if}}

      </div>

    </div>

  </div>

  <!-- RIGHT -->
  <div class="creature-info-right">

    <!-- DESCRIPTION -->
    <div class="creature-info-card">

      <div class="note-header">

        <label>📜 {{localize "SDP.TabDescription"}}</label>

        <button
          type="button"
          class="note-edit-btn"
          data-action="toggleEditor"
          data-target="creatureDescription">

          ✏️ {{localize "SDP.Edit"}}

        </button>

      </div>

      <!-- DISPLAY -->
      <div
        class="creature-note-display"
        data-display="creatureDescription">

        {{{system.description.value}}}

      </div>

      <!-- EDITOR -->
      <div
        class="creature-note-editor"
        data-editor="creatureDescription"
        style="display:none;">

        <prose-mirror
          name="system.description.value"
          value="{{system.description.value}}">

          {{{system.description.value}}}

        </prose-mirror>

      </div>

    </div>

    <!-- PLAYER NOTES -->
    <div class="creature-info-card">

      <div class="note-header">

        <label>📖 {{localize "SDP.PlayerNotes"}}</label>

        {{#if canEditPlayerNotes}}
        <button
          type="button"
          class="note-edit-btn"
          data-action="toggleEditor"
          data-target="creaturePlayerNotes">

          ✏️ {{localize "SDP.Edit"}}

        </button>
        {{/if}}

      </div>

      <!-- DISPLAY -->
      <div
        class="creature-note-display"
        data-display="creaturePlayerNotes">

        {{{system.details.playerNotes.value}}}

      </div>

      <!-- EDITOR -->
      <div
        class="creature-note-editor"
        data-editor="creaturePlayerNotes"
        style="display:none;">

        <prose-mirror
          name="system.details.playerNotes.value"
          value="{{system.details.playerNotes.value}}">

          {{{system.details.playerNotes.value}}}

        </prose-mirror>

      </div>

    </div>

    {{#if user.isGM}}
    <!-- GM NOTES / BESTIAIRE -->
    <div class="creature-info-card">

      <div class="note-header">

        <label>🔒 {{localize "SDP.GMNotes"}}</label>

        <button
          type="button"
          class="note-edit-btn"
          data-action="toggleEditor"
          data-target="creatureGMNotes">

          ✏️ {{localize "SDP.Edit"}}

        </button>

      </div>

      {{#if hasCreatureBestiary}}
      <div
        class="creature-bestiary-text"
        data-creature-bestiary>{{creatureBestiaryText}}</div>
      {{/if}}

      <!-- DISPLAY (notes perso MJ) -->
      <div
        class="creature-note-display"
        data-display="creatureGMNotes">

        {{{system.details.gmNotes.value}}}

      </div>

      <!-- EDITOR -->
      <div
        class="creature-note-editor"
        data-editor="creatureGMNotes"
        style="display:none;">

        <prose-mirror
          name="system.details.gmNotes.value"
          value="{{system.details.gmNotes.value}}">

          {{{system.details.gmNotes.value}}}

        </prose-mirror>

      </div>

    </div>

    {{/if}}

  </div>

</div>

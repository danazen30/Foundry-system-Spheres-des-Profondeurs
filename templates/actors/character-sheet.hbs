<div class="sdp-sheet">

  <header class="sheet-header">
    <h1>{{actor.name}}</h1>
  </header>

  <section class="sheet-body">

<div class="attributes-grid">

<div class="attr-header"></div>

{{#each attributes as |attr|}}

<div class="attr-header">

  {{attr.label}}

  {{#if ../currentCareer}}
    {{#if (includes ../currentCareer.system.characteristics attr.key)}}
      <button
  data-action="advanceAttribute"
  data-attr="{{attr.key}}"
  title="Cost: ? XP">
  {{#if (gte attr.advances (multiply ../currentCareer.system.level 5))}}
  ✔
{{else}}
  +
{{/if}}
</button>
    {{/if}}
  {{/if}}

</div>

{{/each}}

<!-- INIT -->
<div class="attr-row">Init</div>
{{#each attributes as |attr|}}
<input
type="number"
name="system.attributes.{{attr.key}}.initial"
value="{{attr.initial}}"
data-key="init-{{attr.key}}">
{{/each}}

<!-- ADV -->
<div class="attr-row">Adv</div>
{{#each attributes as |attr|}}

<div class="attr-cell">

 <input
  type="number"
  value="{{attr.advances}}"
  name="system.attributes.{{attr.key}}.advances"
  data-dtype="Number"
  step="1"
  {{#unless @root.user.isGM}}readonly{{/unless}}
>
</div>

{{/each}}

<!-- MODIFIER (VERSION STABLE) -->
<div class="attr-row">Mod</div>
{{#each attributes as |attr|}}
<input
type="number"
class="attr-modifier-input"
data-key="{{attr.key}}"
value="{{attr.modifier}}">
{{/each}}

<!-- FINAL -->
<div class="attr-row">Final</div>
{{#each attributes as |attr|}}
<input
  type="number"
  value="{{attr.value}}"
  readonly
  data-action="rollAttribute"
  data-attr="{{attr.key}}">
{{/each}}

</div>

<h2>Resources</h2>

<div class="health-container">

<label>Health</label>

<input
type="number"
name="system.health.value"
value="{{system.health.value}}">

<span>/ {{system.health.max}}</span>

</div>

<div class="mana-container">

  <label>Mana</label>

  <input
    type="number"
    name="system.resources.mana.value"
    value="{{system.resources.mana.value}}"
  />

  <span>/ {{system.resources.mana.max}}</span>

</div>

<div class="resource-row">

<label>Move</label>

<input
type="number"
class="movement-input"
value="{{system.resources.movement.current}}">

</div>

<div class="resource-row">

<label>Walk</label>

<input
type="number"
value="{{system.resources.movement.walk}}"
readonly>

</div>

<div class="resource-row">

<label>Run</label>

<input
type="number"
value="{{system.resources.movement.run}}"
readonly>

</div>

<div class="resource-row encumbrance-line">

  <label>Encumbrance</label>

  <!-- 🔥 CADRE -->
  <div class="encumbrance-box">

    <input
      type="number"
      value="{{system.resources.encumbrance.value}}"
      readonly
    >

    <span>/ {{system.resources.encumbrance.max}}</span>

  </div>

  <!-- 🔥 TEXTE SUR LA MEME LIGNE -->
  {{#if system.resources.encumbrance.state.label}}
    <span class="encumbrance-warning">
      {{system.resources.encumbrance.state.label}}
    </span>
  {{/if}}

</div>

<h2>Derived</h2>

<div class="derived">

<p>Parry : {{system.derived.parry.value}}</p>
<p>Evasion : {{system.derived.evasion.value}}</p>
<p>Wound Threshold : {{system.derived.woundThreshold.value}}</p>
<p>Attack : {{system.derived.attack.value}}</p>

</div>

<h2>Skills</h2>

<table class="skills-table">

<thead>
<tr>
<th>Name</th>
<th>Characteristic</th>
<th>Adv</th>
<th>Value</th>
<th></th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "skill")}}


<tr>

<td>
  {{item.name}}

  {{#if ../currentCareer}}
    {{#if (includes ../currentCareer.system.skills item.name)}}
      <button
        data-action="advanceSkill"
        data-item-id="{{item.id}}"
        title="Cost: ? XP">
        {{#if (gte item.system.advances (multiply ../currentCareer.system.level 5))}}
          ✔
        {{else}}
          +
        {{/if}}
      </button>
    {{/if}}
  {{/if}}

</td>

<td>{{item.system.characteristic}}</td>

<td>
  <input
    type="number"
    data-action="updateSkillAdv"
    data-item-id="{{item.id}}"
    value="{{item.system.advances}}"
    {{#unless ../user.isGM}}readonly{{/unless}}
  >
</td>

<td data-action="rollSkill" data-item-id="{{item.id}}">
  {{item.system.value}}
</td>

<td class="item-actions">
  <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
</td>

</tr>

{{/if}}
{{/each}}

<td data-action="rollSkill" data-item-id="{{item.id}}">
{{item.system.value}}
</td>


</tbody>

</table>


<h2>Talents</h2>

<table class="talents-table">

<thead>
<tr>
<th>Name</th>
<th>Level</th>
<th>Max</th>
<th></th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "talent")}}

<tr>

<td>
  {{item.name}}

  {{#if ../currentCareer}}
    {{#if (includes ../currentCareer.system.talents item.name)}}
      <button
        data-action="advanceTalent"
        data-item-id="{{item.id}}"
        title="Cost: ? XP">
        +
      </button>
    {{/if}}
  {{/if}}
</td>

<td>
  <input
    type="number"
    data-action="updateTalentAdv"
    data-item-id="{{item.id}}"
    value="{{item.system.advances}}"
    min="0"

    max="{{#if (lookup ../system.attributes item.system.max)}}
      {{lookup (lookup ../system.attributes item.system.max) "bonus"}}
    {{else}}
      {{item.system.max}}
    {{/if}}"

    {{#unless ../user.isGM}}readonly{{/unless}}
  >
</td>

<td>
  {{#if (lookup ../system.attributes item.system.max)}}
    {{lookup (lookup ../system.attributes item.system.max) "bonus"}}
  {{else}}
    {{item.system.max}}
  {{/if}}
</td>

<td class="item-actions">
  <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>


<h2>Melee Weapons</h2>

<table class="weapons-table">
<thead>
<tr>
<th>Name</th>
<th>Skill</th>
<th>Traits</th>
<th>Damage</th>
<th>Equip</th>
<th>Offhand</th>
<th>Defense</th>
<th>Attack</th>
<th>Qty</th>
<th></th>
</tr>
</thead>

<tbody>

{{#each meleeWeapons as |item|}}

<tr>

<td>{{item.name}}</td>
<td>{{item.displaySkill}}</td>

<td>

<div class="trait-groups">

  <!-- POSITIFS -->
  <div class="trait-positive">
    {{#each item.displayTraits}}
      {{#if (eq this.type "positive")}}
        <span class="trait-tag positive {{#if this.disabled}}trait-disabled{{/if}}">
          {{this.label}}
        </span>
      {{/if}}
    {{/each}}
  </div>

  <!-- NEGATIFS -->
  <div class="trait-negative">
    {{#each item.displayTraits}}
      {{#if (eq this.type "negative")}}
        <span class="trait-tag negative">
          {{this.label}}
        </span>
      {{/if}}
    {{/each}}
  </div>

</div>

</td>

<td>
  {{item.system.damage}} + {{item.system.damageDice}}
</td>

<td>
  <input
    type="checkbox"
    data-action="toggleWeaponEquip"
    data-item-id="{{item.id}}"
    {{checked item.system.equipped}}
  >
</td>

<td>
  <input
    type="checkbox"
    data-action="toggleOffhand"
    data-item-id="{{item.id}}"
    {{checked item.system.offhand}}
  >
</td>

<td>
  <input type="checkbox"
         class="toggle-defense-weapon"
         data-item-id="{{item._id}}"
         {{checked item.system.isDefenseWeapon}}>
</td>

<td>
  <button data-action="weaponAttack" data-item-id="{{item.id}}">
    Attack
  </button>
</td>

<td>
  {{item.system.quantity.value}}
</td>

<td class="item-actions">
  <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
</td>

</tr>

{{/each}}

</tbody>
</table>

<h2>Ranged Weapons</h2>

<table class="weapons-table">
<thead>
<tr>
<th>Name</th>
<th>Range</th>
<th>Ammo</th>
<th>Damage</th>
<th>Equip</th>
<th>Offhand</th>
<th>Attack</th>
<th>Qty</th>
<th></th>
</tr>
</thead>

<tbody>

{{#each rangedWeapons as |item|}}

<tr>

<td>{{item.name}}</td>

<td>
  {{item.system.range}}

  {{#if item.system.currentAmmo}}
    {{#each item.compatibleAmmo as |ammo|}}
      {{#if (eq ammo.id item.system.currentAmmo)}}
        ({{ammo.system.rangeModifier}})
      {{/if}}
    {{/each}}
  {{/if}}
</td>

<td>
  <div class="ammo-row">

<select data-action="selectAmmo"
        data-item-id="{{this._id}}">

  <option value="">-- Aucun --</option>

  {{#each this.compatibleAmmo}}
    <option value="{{this._id}}"
      {{#if (eq this._id ../system.currentAmmo)}}selected{{/if}}>
      {{this.name}} ({{this.system.quantity.value}})
    </option>
  {{/each}}

</select>

    {{#if this.hasReload}}
      <input type="checkbox"
             class="reload-checkbox"
             data-action="toggleLoaded"
             data-item-id="{{this._id}}"
             {{checked this.system.loaded}}>
    {{/if}}

  </div>
</td>

<td>
  {{item.system.damage}}
  {{#if item.system.damageDice}}
    + {{item.system.damageDice}}
  {{/if}}

  {{#if item.system.currentAmmo}}
    {{#each item.compatibleAmmo as |ammo|}}
      {{#if (eq ammo.id item.system.currentAmmo)}}

        {{#if ammo.system.damage.base.value}}
          + {{ammo.system.damage.base.value}}
        {{/if}}

        {{#if ammo.system.damage.dice.value}}
          + {{ammo.system.damage.dice.value}}
        {{/if}}

      {{/if}}
    {{/each}}
  {{/if}}
</td>

<td>
  <input
    type="checkbox"
    data-action="toggleWeaponEquip"
    data-item-id="{{item.id}}"
    {{checked item.system.equipped}}
  >
</td>

<td>
  <input
    type="checkbox"
    data-action="toggleOffhand"
    data-item-id="{{item.id}}"
    {{checked item.system.offhand}}
  >
</td>

<td>
  <button data-action="weaponAttack" data-item-id="{{item.id}}">
    Shoot
  </button>
</td>

<td>
  {{item.system.quantity.value}}
</td>

<td class="item-actions">
  <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
</td>

</tr>

{{/each}}

</tbody>
</table>

<h2>Ammunition</h2>

<table class="ammo-table">
<thead>
<tr>
<th>Name</th>
<th>Group</th>
<th>Qty</th>
<th>Damage</th>
<th>Range Mod</th>
<th></th>
</tr>
</thead>

<tbody>

{{#each ammunition as |item|}}

<tr>

<td>{{item.name}}</td>

<td>{{item.system.weaponGroup}}</td>

<td>
  <input
    type="number"
    data-action="updateAmmoQty"
    data-item-id="{{item.id}}"
    value="{{item.system.quantity.value}}"
    min="0"
  >
</td>

<td>
  {{item.system.damage.base.value}}
  {{#if item.system.damage.dice.value}}
    + {{item.system.damage.dice.value}}
  {{/if}}
</td>

<td>{{item.system.rangeModifier}}</td>

<td class="item-actions">
  <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
</td>

</tr>

{{/each}}

</tbody>
</table>

<h2>Armors</h2>

<table class="armors-table">

<thead>
<tr>
<th>Name</th>
<th>Head</th>
<th>Body</th>
<th>L Arm</th>
<th>R Arm</th>
<th>L Leg</th>
<th>R Leg</th>
<th>Worn</th>
<th></th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "armor")}}

<tr>

<td>{{item.name}}</td>

<td>{{item.system.AP.head}}</td>
<td>{{item.system.AP.body}}</td>
<td>{{item.system.AP.leftArm}}</td>
<td>{{item.system.AP.rightArm}}</td>
<td>{{item.system.AP.leftLeg}}</td>
<td>{{item.system.AP.rightLeg}}</td>

<td>
  <input
    type="checkbox"
    data-action="toggleArmor"
    data-item-id="{{item.id}}"
    {{checked item.system.worn.value}}>
</td>

<td class="item-actions">
  <button data-action="editItem" data-item-id="{{item.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{item.id}}">🗑️</button>
</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>

<h2>Conditions</h2>

<section class="conditions">

<ul class="conditions-list">

{{#each system.conditions as |value key|}}

<li class="condition flexrow">

<span class="condition-name">
{{key}}
</span>

{{#if (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}

<input
  type="checkbox"
  data-action="updateConditionState"
  data-key="{{key}}"
  {{checked value}}
/>

{{else}}

<input
  type="number"
  class="condition-input"
  data-key="{{key}}"
  value="{{lookup ../system.conditionTotals key}}"
  min="0"
  style="width:40px"
/>

{{/if}}

</li>

{{/each}}

</ul>

</section>

<h2>Injuries</h2>

<table class="injuries-table">

<thead>
<tr>
<th>Name</th>
<th>Severity</th>
<th>Location</th>
<th>Duration</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "injury")}}

<tr>

<td>{{item.name}}</td>
<td>{{item.system.severity}}</td>
<td>{{item.system.location}}</td>
<td>{{item.system.duration}}</td>

<td>
  <button data-action="editItem" data-item-id="{{item.id}}">
    ✏️
  </button>

  <button data-action="deleteItem" data-item-id="{{item.id}}">
    🗑️
  </button>
</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>

<h2>Spells</h2>

  <h3>Minor</h3>

<table class="spells-table">
<thead>
<tr>
  <th>Name</th>
  <th>Mana</th>
  <th>Mem</th>
  <th>Actions</th>
</tr>
</thead>

<tbody>
{{#each spellsMinor as |spell|}}
<tr>

<td>{{spell.name}}</td>

<td>
  {{#if spell.system.memorized.value}}
    {{spell.system.power.value}}
  {{else}}
    {{multiply spell.system.power.value 2}}
  {{/if}}
</td>

<td>
  <input type="checkbox"
    data-action="toggleSpellMemory"
    data-item-id="{{spell.id}}"
    {{checked spell.system.memorized.value}}>
</td>

<td class="item-actions">
  <button data-action="castSpell" data-item-id="{{spell.id}}">Cast</button>
  <button data-action="editItem" data-item-id="{{spell.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{spell.id}}">🗑️</button>
</td>

</tr>
{{/each}}
</tbody>
</table>

<h3>Advanced</h3>

<table class="spells-table">
<thead>
<tr>
  <th>Name</th>
  <th>Mana</th>
  <th>Mem</th>
  <th>Actions</th>
</tr>
</thead>

<tbody>
{{#each spellsAdvanced as |spell|}}
<tr>

<td>{{spell.name}}</td>

<td>
  {{#if spell.system.memorized.value}}
    {{spell.system.power.value}}
  {{else}}
    {{multiply spell.system.power.value 2}}
  {{/if}}
</td>

<td>
  <input type="checkbox"
    data-action="toggleSpellMemory"
    data-item-id="{{spell.id}}"
    {{checked spell.system.memorized.value}}>
</td>

<td class="item-actions">
  <button data-action="castSpell" data-item-id="{{spell.id}}">Cast</button>
  <button data-action="editItem" data-item-id="{{spell.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{spell.id}}">🗑️</button>
</td>

</tr>
{{/each}}
</tbody>
</table>

<h3>Superior</h3>

<table class="spells-table">
<thead>
<tr>
  <th>Name</th>
  <th>Mana</th>
  <th>Mem</th>
  <th>Actions</th>
</tr>
</thead>

<tbody>
{{#each spellsSuperior as |spell|}}
<tr>

<td>{{spell.name}}</td>

<td>
  {{#if spell.system.memorized.value}}
    {{spell.system.power.value}}
  {{else}}
    {{multiply spell.system.power.value 2}}
  {{/if}}
</td>

<td>
  <input type="checkbox"
    data-action="toggleSpellMemory"
    data-item-id="{{spell.id}}"
    {{checked spell.system.memorized.value}}>
</td>

<td class="item-actions">
  <button data-action="castSpell" data-item-id="{{spell.id}}">Cast</button>
  <button data-action="editItem" data-item-id="{{spell.id}}">✏️</button>
  <button data-action="deleteItem" data-item-id="{{spell.id}}">🗑️</button>
</td>

</tr>
{{/each}}
</tbody>
</table>

<h2>Details</h2>

<div class="details">

  <div class="resource-row">
    <label>Career</label>
    <input type="text" name="system.details.career.value" value="{{system.details.career.value}}">
  </div>

  <div class="resource-row">
    <label>Career Group</label>
    <input type="text" name="system.details.careerGroup.value" value="{{system.details.careerGroup.value}}">
  </div>

  <div class="resource-row">
    <label>Standing</label>
    <input type="text" name="system.details.standing.value" value="{{system.details.standing.value}}">
  </div>

  <div>
  <label>Sign:</label>
  {{#if sign}}
  <span>{{sign.name}}</span>
{{else}}
  <span>No Sign</span>
{{/if}}
</div>

  <div class="level-progression">

  <h3>Level Progression</h3>

  {{#if levelProgression.length}}
    <ul>
      {{#each levelProgression}}
        <li>
  <strong>Level {{this.level}}</strong> → +{{this.hp}} HP

  {{#if this.description}}
    <p class="level-desc">{{this.description}}</p>
  {{/if}}
</li>
      {{/each}}
    </ul>
  {{else}}
    <p>No level progression yet</p>
  {{/if}}

</div>

</div>

<h2>Experience</h2>

<div class="xp-container">

  <div class="resource-row">
    <label>Total</label>
    <input
      type="number"
      value="{{xp.total}}"
      data-action="updateXP"
      data-type="total"
      {{#unless user.isGM}}readonly{{/unless}}
    >
  </div>

  <div class="resource-row">
    <label>Spent</label>
    <input
  type="number"
  value="{{xp.spent}}"
  data-action="updateXP"
  data-type="spent"
  {{#unless user.isGM}}readonly{{/unless}}
>
  </div>

  <div class="resource-row">
    <label>Available</label>
    <input
      type="number"
      value="{{xp.available}}"
      readonly
    >
  </div>

  <div class="xp-bar">

  <div class="xp-label">
    XP: {{xpBar.value}}
    {{#if xpBar.nextXP}}
      / {{xpBar.nextXP}}
    {{else}}
      (MAX)
    {{/if}}
  </div>

  <div class="xp-bar-bg">
    <div class="xp-bar-fill" style="width: {{xpBar.percent}}%;"></div>
  </div>

</div>

</div>

{{#if canLevelUp}}
  <div class="level-up">
    <button data-action="levelUp">
      Level Up Available → {{availableLevel}}
    </button>
  </div>
{{/if}}

<h3>XP Log</h3>

<ul class="xp-log">

{{#if xp.log.length}}
  {{#each xp.log}}
    <li class="xp-entry">
      {{this.label}}
    </li>
  {{/each}}
{{else}}
  <li>No XP activity</li>
{{/if}}

</ul>

<h2>Careers</h2>

<table class="careers-table">

<thead>
<tr>
<th>Name</th>
<th>Current</th>
<th>Completed</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "career")}}

<tr>

<td>{{item.name}}</td>

<td>
<input type="checkbox"
       data-action="toggleCareerCurrent"
       data-item-id="{{item.id}}"
       {{checked item.system.current}}>
</td>

<td>
<input type="checkbox"
       data-action="toggleCareerCompleted"
       data-item-id="{{item.id}}"
       {{checked item.system.completed}}>
</td>

<td class="item-actions">

  <button data-action="editItem" data-item-id="{{item.id}}">
    ✏️
  </button>

  <button data-action="deleteItem" data-item-id="{{item.id}}">
    🗑️
  </button>

</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>

</section>
</div>
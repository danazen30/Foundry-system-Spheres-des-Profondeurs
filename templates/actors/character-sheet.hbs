<div class="sdp-sheet">

  <header class="sheet-header">
    <h1>{{actor.name}}</h1>
  </header>

  <section class="sheet-body">

<div class="attributes-grid">

<div class="attr-header"></div>

{{#each attributes as |attr|}}
<div class="attr-header">{{attr.label}}</div>
{{/each}}

<!-- INIT -->
<div class="attr-row">Init</div>
{{#each attributes as |attr|}}
<input
type="number"
name="system.attributes.{{attr.key}}.initial"
value="{{attr.initial}}"
data-key="init-{{attr.key}}">
{{/each}}

<!-- ADV -->
<div class="attr-row">Adv</div>
{{#each attributes as |attr|}}
<input
type="number"
name="system.attributes.{{attr.key}}.advances"
value="{{attr.advances}}"
data-key="adv-{{attr.key}}">
{{/each}}

<!-- MODIFIER (VERSION STABLE) -->
<div class="attr-row">Mod</div>
{{#each attributes as |attr|}}
<input
type="number"
class="attr-modifier-input"
data-key="{{attr.key}}"
value="{{attr.modifier}}">
{{/each}}

<!-- FINAL -->
<div class="attr-row">Final</div>
{{#each attributes as |attr|}}
<input
  type="number"
  value="{{attr.value}}"
  readonly
  data-action="rollAttribute"
  data-attr="{{attr.key}}">
{{/each}}

</div>

<h2>Resources</h2>

<div class="health-container">

<label>Health</label>

<input
type="number"
name="system.health.value"
value="{{system.health.value}}">

<span>/ {{system.health.max}}</span>

</div>

<div class="resource-row">

<label>Mana</label>

<input
type="number"
name="system.resources.mana.value"
value="{{system.resources.mana.value}}">

</div>

<div class="resource-row">

<label>Move</label>

<input
type="number"
class="movement-input"
value="{{system.resources.movement.current}}">

</div>

<div class="resource-row">

<label>Walk</label>

<input
type="number"
value="{{system.resources.movement.walk}}"
readonly>

</div>

<div class="resource-row">

<label>Run</label>

<input
type="number"
value="{{system.resources.movement.run}}"
readonly>

</div>

<h2>Derived</h2>

<div class="derived">

<p>Parry : {{system.derived.parry.value}}</p>
<p>Evasion : {{system.derived.evasion.value}}</p>
<p>Wound Threshold : {{system.derived.woundThreshold.value}}</p>
<p>Attack : {{system.derived.attack.value}}</p>

</div>

<h2>Skills</h2>

<table class="skills-table">

<thead>
<tr>
<th>Name</th>
<th>Characteristic</th>
<th>Adv</th>
<th>Value</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "skill")}}

<tr>

<td>{{item.name}}</td>

<td>{{item.system.characteristic}}</td>

<td>
<input
  type="number"
  data-action="updateSkillAdv"
  data-item-id="{{item.id}}"
  value="{{item.system.advances}}"
  data-event="change">   <!-- 🔥 IMPORTANT -->
</td>

<td data-action="rollSkill" data-item-id="{{item.id}}">

{{item.system.value}}

</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>


<h2>Talents</h2>

<table class="talents-table">

<thead>
<tr>
<th>Name</th>
<th>Level</th>
<th>Max</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "talent")}}

<tr>

<td>{{item.name}}</td>

<td>

<input
type="number"
data-action="updateTalentAdv"
data-item-id="{{item.id}}"
value="{{item.system.advances}}"
min="0"

max="{{#if (lookup ../system.attributes item.system.max)}}{{lookup (lookup ../system.attributes item.system.max) "bonus"}}{{else}}{{item.system.max}}{{/if}}"

{{#unless item.system.canAdvance}}disabled{{/unless}}
>

</td>

<td>

{{#if (lookup ../system.attributes item.system.max)}}
{{lookup (lookup ../system.attributes item.system.max) "bonus"}}
{{else}}
{{item.system.max}}
{{/if}}

</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>


<h2>Weapons</h2>

<table class="weapons-table">

<thead>
<tr>
<th>Name</th>
<th>Skill</th>
<th>Atk</th>
<th>Parry</th>
<th>Offhand</th>
<th>Equipped</th>
<th>Damage</th>
<th>Attack</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "weapon")}}

<tr>

<td>{{item.name}}</td>

<td>{{item.system.skill}}</td>

<td>{{item.system.attackBonus}}</td>

<td>{{item.system.parryBonus}}</td>

<td>
<input
  type="checkbox"
  data-action="toggleOffhand"
  data-item-id="{{item.id}}"
  {{checked item.system.offhand}}>
</td>
<td>
<input type="checkbox"
  data-action="toggleWeaponEquip"
  data-item-id="{{item.id}}"
  {{checked item.system.equipped}}>
</td>

<td>

{{item.system.finalDamage}}

{{#if item.system.damageDice}}
 + {{item.system.damageDice}}
{{/if}}

</td>


<td>
<button data-action="weaponAttack" data-item-id="{{item.id}}">
Attack
</button>
</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>

<h2>Armors</h2>

<table class="armors-table">

<thead>
<tr>
<th>Name</th>
<th>Head</th>
<th>Body</th>
<th>L Arm</th>
<th>R Arm</th>
<th>L Leg</th>
<th>R Leg</th>
<th>Worn</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "armor")}}

<tr>

<td>{{item.name}}</td>

<td>{{item.system.AP.head}}</td>

<td>{{item.system.AP.body}}</td>

<td>{{item.system.AP.leftArm}}</td>

<td>{{item.system.AP.rightArm}}</td>

<td>{{item.system.AP.leftLeg}}</td>

<td>{{item.system.AP.rightLeg}}</td>

<td>
<input
  type="checkbox"
  data-action="toggleArmor"
  data-item-id="{{item.id}}"
  {{checked item.system.worn.value}}>
</td>
</tr>

{{/if}}
{{/each}}

</tbody>

</table>

<h2>Conditions</h2>

<section class="conditions">

<ul class="conditions-list">

{{#each system.conditions as |value key|}}

<li class="condition flexrow">

<span class="condition-name">
{{key}}
</span>

{{#if (eq (lookup (lookup ../config.conditionConfig key) "type") "state")}}

<input
  type="checkbox"
  data-action="updateConditionState"
  data-key="{{key}}"
  {{checked value}}
/>

{{else}}

<input
  type="number"
  class="condition-input"
  data-key="{{key}}"
  value="{{lookup ../system.conditionTotals key}}"
  min="0"
  style="width:40px"
/>

{{/if}}

</li>

{{/each}}

</ul>

</section>

<h2>Injuries</h2>

<table class="injuries-table">

<thead>
<tr>
<th>Name</th>
<th>Severity</th>
<th>Location</th>
<th>Duration</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "injury")}}

<tr>

<td>{{item.name}}</td>
<td>{{item.system.severity}}</td>
<td>{{item.system.location}}</td>
<td>{{item.system.duration}}</td>

<td>
  <button data-action="editItem" data-item-id="{{item.id}}">
    ✏️
  </button>

  <button data-action="deleteItem" data-item-id="{{item.id}}">
    🗑️
  </button>
</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>

<h2>Details</h2>

<div class="details">

  <div class="resource-row">
    <label>Career</label>
    <input type="text" name="system.details.career.value" value="{{system.details.career.value}}">
  </div>

  <div class="resource-row">
    <label>Career Group</label>
    <input type="text" name="system.details.careerGroup.value" value="{{system.details.careerGroup.value}}">
  </div>

  <div class="resource-row">
    <label>Standing</label>
    <input type="text" name="system.details.standing.value" value="{{system.details.standing.value}}">
  </div>

</div>

<h2>Careers</h2>

<table class="careers-table">

<thead>
<tr>
<th>Name</th>
<th>Current</th>
<th>Completed</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

{{#each actor.items as |item|}}
{{#if (eq item.type "career")}}

<tr>

<td>{{item.name}}</td>

<td>
<input type="checkbox"
       data-action="toggleCareerCurrent"
       data-item-id="{{item.id}}"
       {{checked item.system.current}}>
</td>

<td>
<input type="checkbox"
       data-action="toggleCareerCompleted"
       data-item-id="{{item.id}}"
       {{checked item.system.completed}}>
</td>

<td>
<button data-action="deleteItem" data-item-id="{{item.id}}">
🗑️
</button>
</td>

</tr>

{{/if}}
{{/each}}

</tbody>

</table>

</section>
</div>
<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.sign"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Attributes"}}</label>

      <select name="system.attribute">

        {{selectOptions
          characteristicOptions
          selected=system.attribute}}

      </select>

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="overcast-header">

    <div class="weapon-card-title">
      {{localize "SDP.Levels"}}
    </div>

    <button
      type="button"
      class="effect-create-button add-level">

      ✚ {{localize "SDP.AddLevel"}}

    </button>

  </div>

  <div class="sign-levels-layout">

    {{#each system.levels as |lvl key|}}

    <div
      class="sign-level-card"
      data-level="{{key}}">

      <button
        type="button"
        class="remove-overcast-special delete-level">

        ✖

      </button>

      <div class="sign-level-title">
        {{localize "SDP.Level"}} {{key}}
      </div>

      <div class="sign-level-grid">

        <div class="form-group">

          <label>{{localize "SDP.HPDice"}}</label>

          <input
            type="text"
            name="system.levels.{{key}}.hp"
            value="{{lvl.hp}}">

        </div>

        <div class="form-group">

          <label>{{localize "SDP.DamageBonus"}}</label>

          <input
            type="text"
            name="system.levels.{{key}}.damageBonus"
            value="{{lvl.damageBonus}}">

        </div>

        <div class="form-group full-width">

          <label>{{localize "SDP.InspirationDice"}}</label>

          <input
            type="text"
            name="system.levels.{{key}}.inspirationDice"
            value="{{lvl.inspirationDice}}">

        </div>

        <div class="form-group full-width">

          <label>{{localize "SDP.TabDescription"}}</label>

          {{#if lvl.localizedDescription}}
          <p class="career-field-hint sign-level-description-hint">{{lvl.localizedDescription}}</p>
          {{/if}}

        </div>

      </div>

    </div>

    {{/each}}

  </div>

</div>

{{/if}}

</div>
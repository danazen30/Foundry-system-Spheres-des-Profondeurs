<div class="sdp-item-sheet">

  <h2>{{item.name}}</h2>

  <div>
    <label>Attribute:</label>
    <input type="text" name="system.attribute" value="{{system.attribute}}">
  </div>

  <hr>

  <div class="sign-levels">

  <h2>Levels</h2>

  <button type="button" class="add-level">+ Add Level</button>

  {{#each system.levels as |lvl key|}}
    <div class="level-block" data-level="{{key}}">

      <h3>Level {{key}}</h3>

      <label>HP Dice</label>
      <input type="text" name="system.levels.{{key}}.hp" value="{{lvl.hp}}" placeholder="1d4" />

      <label>Damage Bonus</label>
      <input type="text" name="system.levels.{{key}}.damageBonus" value="{{lvl.damageBonus}}" />

      <label>Inspiration Dice</label>
      <input type="text" name="system.levels.{{key}}.inspirationDice" value="{{lvl.inspirationDice}}" />

      <div class="form-group">
  <label>Description</label>
  <textarea
    name="system.levels.{{@key}}.description"
  >{{this.description}}</textarea>
</div>

      <button type="button" class="delete-level">Delete</button>

    </div>
  {{/each}}

</div>

</div>
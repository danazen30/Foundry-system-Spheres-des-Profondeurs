<div class="sdp-item-sheet">

<h1>
  <input type="text" name="name" value="{{item.name}}" />
</h1>

<div class="spell-img">
  <img 
    src="{{item.img}}" 
    data-edit="img" 
    title="{{item.name}}"
  />
</div>

<h2>Status</h2>
<input type="text" name="system.status" value="{{system.status}}">

<h2>Level</h2>
<input type="number" name="system.level" value="{{system.level}}">

<h2>Characteristics</h2>
<input type="text" name="system.characteristics" value="{{system.characteristics}}">

<h2>Skills</h2>
<input type="text" name="system.skills" value="{{system.skills}}">

<h2>Talents</h2>
<input type="text" name="system.talents" value="{{system.talents}}">

<h2>Trappings</h2>
<textarea name="system.trappings">{{system.trappings}}</textarea>

<h2>Career Group</h2>
<input type="text" name="system.careerGroup" value="{{system.careerGroup}}">

<h2>Standing</h2>
<input type="text" name="system.standing" value="{{system.standing}}">

</div>
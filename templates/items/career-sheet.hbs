<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.career"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>{{localize "SDP.Status"}}</label>

      <input
        type="text"
        name="system.status"
        value="{{system.status}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Level"}}</label>

      <input
        type="number"
        name="system.level"
        value="{{system.level}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.CareerGroup"}}</label>

      <input
        type="text"
        name="system.careerGroup"
        value="{{system.careerGroup}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Standing"}}</label>

      <input
        type="text"
        name="system.standing"
        value="{{system.standing}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Advances"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Characteristics"}}</label>

      <input
        type="text"
        name="system.characteristics"
        value="{{system.characteristics}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Skills"}}</label>

      <input
        type="text"
        name="system.skills"
        value="{{system.skills}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Talents"}}</label>

      <input
        type="text"
        name="system.talents"
        value="{{system.talents}}">

    </div>

  </div>

</div>

<div class="form-group full-width">

  <label>{{localize "SDP.WorkSkill"}}</label>

  <input
    type="text"
    name="system.workSkill"
    value="{{system.workSkill}}">

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Trappings"}}
  </div>

  <div class="form-group">

    <textarea
      name="system.trappings"
      rows="6"
    >{{system.trappings}}</textarea>

  </div>

</div>

{{/if}}

</div>
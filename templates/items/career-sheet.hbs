<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Career
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Status</label>

      <input
        type="text"
        name="system.status"
        value="{{system.status}}">

    </div>

    <div class="form-group">

      <label>Level</label>

      <input
        type="number"
        name="system.level"
        value="{{system.level}}">

    </div>

    <div class="form-group full-width">

      <label>Career Group</label>

      <input
        type="text"
        name="system.careerGroup"
        value="{{system.careerGroup}}">

    </div>

    <div class="form-group full-width">

      <label>Standing</label>

      <input
        type="text"
        name="system.standing"
        value="{{system.standing}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Advances
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>Characteristics</label>

      <input
        type="text"
        name="system.characteristics"
        value="{{system.characteristics}}">

    </div>

    <div class="form-group full-width">

      <label>Skills</label>

      <input
        type="text"
        name="system.skills"
        value="{{system.skills}}">

    </div>

    <div class="form-group full-width">

      <label>Talents</label>

      <input
        type="text"
        name="system.talents"
        value="{{system.talents}}">

    </div>

  </div>

</div>

<div class="form-group full-width">

  <label>Work Skill</label>

  <input
    type="text"
    name="system.workSkill"
    value="{{system.workSkill}}">

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Trappings
  </div>

  <div class="form-group">

    <textarea
      name="system.trappings"
      rows="6"
    >{{system.trappings}}</textarea>

  </div>

</div>

{{/if}}

</div>
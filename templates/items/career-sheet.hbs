<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.career"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Level"}}</label>

      <input
        type="number"
        name="system.level"
        value="{{system.level}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.CareerGroup"}}</label>

      <input
        type="text"
        name="system.careerGroup"
        value="{{system.careerGroup}}">

      {{#if display.careerGroup}}
      <p class="career-field-hint">{{display.careerGroup}}</p>
      {{/if}}

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Standing"}}</label>

      <input
        type="text"
        name="system.standing"
        value="{{system.standing}}">

      {{#if display.standing}}
      <p class="career-field-hint">{{display.standing}}</p>
      {{/if}}

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Advances"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Characteristics"}}</label>

      <input
        type="text"
        name="system.characteristics"
        value="{{system.characteristics}}">

      {{#if display.characteristics}}
      <p class="career-field-hint">{{display.characteristics}}</p>
      {{/if}}

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Skills"}}</label>

      <input
        type="text"
        name="system.skills"
        value="{{system.skills}}">

      {{#if display.skills}}
      <p class="career-field-hint">{{display.skills}}</p>
      {{/if}}

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Talents"}}</label>

      <input
        type="text"
        name="system.talents"
        value="{{system.talents}}">

      {{#if display.talents}}
      <p class="career-field-hint">{{display.talents}}</p>
      {{/if}}

    </div>

  </div>

</div>

<div class="form-group full-width">

  <label>{{localize "SDP.WorkSkill"}}</label>

  <input
    type="text"
    name="system.workSkill"
    value="{{system.workSkill}}">

  {{#if display.workSkill}}
  <p class="career-field-hint">{{display.workSkill}}</p>
  {{/if}}

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Trappings"}}
  </div>

  <div class="form-group">

    <textarea
      name="system.trappings"
      rows="6"
    >{{system.trappings}}</textarea>

    {{#if display.trappings}}
    <p class="career-field-hint career-field-hint-multiline">{{display.trappings}}</p>
    {{/if}}

  </div>

</div>

{{/if}}

</div>
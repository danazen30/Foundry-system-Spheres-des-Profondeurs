<div class="sdp-item-sheet">

<h1>
  <input type="text" name="name" value="{{item.name}}" />
</h1>

<h3>Quantity</h3>

<div class="form-group">
  <input
    type="number"
    name="system.quantity.value"
    value="{{system.quantity.value}}"
    min="0"
  >
</div>

<h2>Ammunition</h2>

<!-- ===================== -->
<!-- WEAPON GROUP -->
<!-- ===================== -->

<div class="form-group">
  <label>Weapon Group</label>
  <input type="text" name="system.weaponGroup" value="{{system.weaponGroup}}">
</div>

<!-- ===================== -->
<!-- DAMAGE -->
<!-- ===================== -->

<h3>Damage</h3>

<div class="form-group">
  <label>Flat</label>
  <input type="number" name="system.damage.base.value" value="{{system.damage.base.value}}">
</div>

<div class="form-group">
  <label>Dice</label>
  <input type="text" name="system.damage.dice.value" value="{{system.damage.dice.value}}">
</div>

<!-- ===================== -->
<!-- RANGE -->
<!-- ===================== -->

<h3>Range Modifier</h3>

<div class="form-group">
  <input type="number" name="system.rangeModifier" value="{{system.rangeModifier}}">
  <p>(Can be negative)</p>
</div>

<!-- ===================== -->
<!-- TRAITS / FLAWS -->
<!-- ===================== -->

<h3>Traits</h3>

<div class="traits-list">
  {{#each traits}}
    <label title="{{this.description}}">
      <input type="checkbox"
             name="system.traits"
             value="{{this.key}}"
             {{#if this.checked}}checked{{/if}}>
      {{this.label}}
    </label>
  {{/each}}
</div>

</div>
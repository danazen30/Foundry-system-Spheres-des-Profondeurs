<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.ammunition"}}
  </div>

  <div class="weapon-grid">

    {{#if isGM}}
    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>
    {{/if}}

    <div class="form-group">

      <label>{{localize "SDP.WeaponGroup"}}</label>

      <select name="system.weaponGroup">
        {{#each weaponGroupOptions}}
          <option
            value="{{this.value}}"
            {{#if (eq ../system.weaponGroup this.value)}}
              selected
            {{/if}}>
            {{this.label}}
          </option>
        {{/each}}
      </select>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.RangeModifier"}}</label>

      <input
        type="number"
        name="system.rangeModifier"
        value="{{system.rangeModifier}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Damage"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>{{localize "SDP.FlatDamage"}}</label>

      <input
        type="number"
        name="system.damage.base.value"
        value="{{system.damage.base.value}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.DamageDice"}}</label>

      <input
        type="text"
        name="system.damage.dice.value"
        value="{{system.damage.dice.value}}">

    </div>

  </div>

</div>

<div class="weapon-traits-layout">

  <div class="weapon-trait-block">

    <h3>{{localize "SDP.Advantages"}}</h3>

    <div class="weapon-traits-grid">

      {{#each positiveTraits}}

      <div class="trait-row" title="{{localize this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.traits.{{this.key}}.selected"
            {{checked this.checked}} />

          <span class="trait-name">
            {{localize this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <div class="weapon-trait-block">

    <h3>{{localize "SDP.Drawbacks"}}</h3>

    <div class="weapon-traits-grid">

      {{#each negativeTraits}}

      <div class="trait-row" title="{{localize this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.traits.{{this.key}}.selected"
            {{checked this.checked}} />

          <span class="trait-name">
            {{localize this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

</div>

{{/if}}

</div>
<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Ammunition
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Weapon Group</label>

      <input
        type="text"
        name="system.weaponGroup"
        value="{{system.weaponGroup}}">

    </div>

    <div class="form-group">

      <label>Range Modifier</label>

      <input
        type="number"
        name="system.rangeModifier"
        value="{{system.rangeModifier}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Damage
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Flat Damage</label>

      <input
        type="number"
        name="system.damage.base.value"
        value="{{system.damage.base.value}}">

    </div>

    <div class="form-group">

      <label>Damage Dice</label>

      <input
        type="text"
        name="system.damage.dice.value"
        value="{{system.damage.dice.value}}">

    </div>

  </div>

</div>

{{/if}}

</div>
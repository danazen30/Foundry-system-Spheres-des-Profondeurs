<div class="sdp-item-sheet">

<h1>
  <input type="text" name="name" value="{{item.name}}" />
</h1>

<div class="form-group">
  <label>Quantity</label>
  <input type="number" name="system.quantity.value" value="{{system.quantity.value}}">
</div>

<h2>Weapon</h2>

<div class="form-group">
  <label>Weapon Category</label>
  <select name="system.category">
    {{selectOptions categoryOptions selected=system.category}}
  </select>
</div>

<div class="form-group">
  <label>Skill</label>
  <input type="text" name="system.skill" value="{{system.skill}}" />
</div>

<div class="form-group">
  <label>Weapon Group</label>
  <input type="text" name="system.weaponGroup" value="{{system.weaponGroup}}" />
</div>

<div class="form-group">
  <label>Attack Bonus</label>
  <input type="number" name="system.attackBonus" value="{{system.attackBonus}}" />
</div>

<div class="form-group">
  <label>Parry Bonus</label>
  <input type="number" name="system.parryBonus" value="{{system.parryBonus}}" />
</div>

<div class="form-group">
  <label>Offhand</label>
  <input type="checkbox" name="system.offhand" {{checked system.offhand}} />
</div>

<div class="form-group">
  <label>Handedness</label>
  <select name="system.handedness">
    {{selectOptions handednessOptions selected=system.handedness}}
  </select>
</div>

<div class="form-group">
  <label>Damage Bonus</label>
  <input type="text" name="system.damage" value="{{system.damage}}">
</div>

<div class="form-group">
  <label>Damage Dice</label>
  <input type="text" name="system.damageDice" value="{{system.damageDice}}">
</div>

{{#if (eq system.category "melee")}}

<div class="form-group">
  <label>Defense Weapon</label>
  <input type="checkbox" name="system.isDefenseWeapon" {{checked system.isDefenseWeapon}}>
</div>

{{/if}}

{{#if (eq system.category "ranged")}}

<h3>Ranged Settings</h3>

<div class="form-group">
  <label>Range</label>
  <input type="number" name="system.range" value="{{system.range}}">
</div>

<div class="form-group">
  <label>Ammunition Group</label>
  <input type="text" name="system.ammunitionGroup" value="{{system.ammunitionGroup}}">
</div>

<div class="form-group">
  <label>Consumes Ammo</label>
  <input type="checkbox" name="system.consumesAmmo" {{checked system.consumesAmmo}}>
</div>

<div class="form-group">
  <label>Force Reload</label>
  <input type="checkbox" name="system.forceReload" {{checked system.forceReload}}>
</div>

{{/if}}

<div class="form-group">
  <label>Equipped</label>
  <input type="checkbox" name="system.equipped" {{checked system.equipped}} />
</div>

<div class="form-group">
  <label>Durability</label>
  <input type="number" name="system.durability.value" value="{{system.durability.value}}">
  /
  <input type="number" name="system.durability.max" value="{{system.durability.max}}">
</div>

<h3>Traits</h3>

<div class="traits-list">
  <h3>Advantages</h3>

{{#each positiveTraits}}
    <div class="trait-row" title="{{this.description}}">

      <label class="trait-label">
        <input type="checkbox"
          name="system.traits.{{this.key}}.selected"
          {{checked this.checked}} />

        <span class="trait-name">{{this.label}}</span>
      </label>

      {{#if this.hasValue}}
        <input type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />
      {{/if}}

    </div>
  {{/each}}

<h3>Drawbacks</h3>

{{#each negativeTraits}}
 <div class="trait-row" title="{{this.description}}">

      <label class="trait-label">
        <input type="checkbox"
          name="system.traits.{{this.key}}.selected"
          {{checked this.checked}} />

        <span class="trait-name">{{this.label}}</span>
      </label>

      {{#if this.hasValue}}
        <input type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />
      {{/if}}

    </div>
{{/each}}

<h3>Item Traits</h3>

<div class="traits-list">

{{#each itemTraits}}

  <div class="trait-row" title="{{this.description}}">

    <label>
      <input type="checkbox"
        name="system.itemTraits.{{this.key}}.selected"
        {{checked this.checked}}>

      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
        name="system.itemTraits.{{this.key}}.value"
        value="{{this.value}}">
    {{/if}}

  </div>

{{/each}}

</div>


</div>
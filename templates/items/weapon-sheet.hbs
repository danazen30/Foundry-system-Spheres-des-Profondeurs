<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    {{localize "SDP.Effects"}}

  </button>

</nav>

{{#if (eq activeTab "details")}}

<!-- ========================= -->
<!-- CORE -->
<!-- ========================= -->

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Core"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Category"}}</label>

      <select name="system.category">
        {{selectOptions categoryOptions selected=system.category}}
      </select>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.AttackType"}}</label>

      <select name="system.damageType">

        {{#each damageTypeOptions}}

          <option
            value="{{this.value}}"
            {{#if (eq ../system.damageType this.value)}}
              selected
            {{/if}}>

            {{this.label}}

          </option>

        {{/each}}

      </select>

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Skill"}}</label>

      <input
        type="text"
        name="system.skill"
        value="{{system.skill}}" />

      {{#if display.skill}}
      <p class="career-field-hint">{{display.skill}}</p>
      {{/if}}

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.WeaponGroup"}}</label>

      <select name="system.weaponGroup">
        {{#each weaponGroupOptions}}
          <option
            value="{{this.value}}"
            {{#if (eq ../system.weaponGroup this.value)}}
              selected
            {{/if}}>
            {{this.label}}
          </option>
        {{/each}}
      </select>

    </div>

  </div>

</div>

<!-- ========================= -->
<!-- COMBAT -->
<!-- ========================= -->

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Combat"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>{{localize "SDP.DamageBonus"}}</label>

      <input
        type="text"
        name="system.damage"
        value="{{system.damage}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.DamageDice"}}</label>

      <input
        type="text"
        name="system.damageDice"
        value="{{system.damageDice}}">

    </div>

  </div>

</div>

<!-- ========================= -->
<!-- HANDLING -->
<!-- ========================= -->

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Handling"}}
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.offhand"
        {{checked system.offhand}} />

      <label>{{localize "SDP.Offhand"}}</label>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Handedness"}}</label>

      <select name="system.handedness">
        {{selectOptions handednessOptions selected=system.handedness}}
      </select>

    </div>

    {{#if (eq system.category "melee")}}

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.isDefenseWeapon"
        {{checked system.isDefenseWeapon}}>

      <label>{{localize "SDP.DefenseWeapon"}}</label>

    </div>

    {{/if}}

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.equipped"
        {{checked system.equipped}} />

      <label>{{localize "SDP.Equipped"}}</label>

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Durability"}}</label>

      <div class="inline-fields">

        <input
          type="number"
          name="system.durability.value"
          value="{{system.durability.value}}">

        <span>/</span>

        <input
          type="number"
          name="system.durability.max"
          value="{{system.durability.max}}">

      </div>

    </div>

  </div>

</div>

<!-- ========================= -->
<!-- RANGED -->
<!-- ========================= -->

{{#if (eq system.category "ranged")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Ranged"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Range"}}</label>

      <input
        type="text"
        name="system.range"
        value="{{system.range}}"
        placeholder="30, SB, SB x 3">

      <p class="career-field-hint">
        {{localize "SDP.WeaponRangeHint"}}
      </p>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.consumesAmmo"
        {{checked system.consumesAmmo}}>

      <label>{{localize "SDP.ConsumesAmmo"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.forceReload"
        {{checked system.forceReload}}>

      <label>{{localize "SDP.ForceReload"}}</label>

    </div>

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- TRAITS -->
<!-- ========================= -->

<div class="weapon-traits-layout">

  <!-- ADVANTAGES -->

  <div class="weapon-trait-block">

    <h3>{{localize "SDP.Advantages"}}</h3>

    <div class="weapon-traits-grid">

      {{#each positiveTraits}}

      <div class="trait-row" title="{{localize this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.traits.{{this.key}}.selected"
            {{checked this.checked}} />

          <span class="trait-name">
            {{localize this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <!-- DRAWBACKS -->

  <div class="weapon-trait-block">

    <h3>{{localize "SDP.Drawbacks"}}</h3>

    <div class="weapon-traits-grid">

      {{#each negativeTraits}}

      <div class="trait-row" title="{{localize this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.traits.{{this.key}}.selected"
            {{checked this.checked}} />

          <span class="trait-name">
            {{localize this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <!-- ITEM TRAITS -->

  <div class="weapon-trait-block">

    <h3>{{localize "SDP.ItemTraits"}}</h3>

    <div class="weapon-traits-grid">

      {{#each positiveItemTraits}}

      <div class="trait-row" title="{{localize this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.itemTraits.{{this.key}}.selected"
            {{checked this.checked}}>

          <span class="trait-name">
            {{localize this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.itemTraits.{{this.key}}.value"
          value="{{this.value}}">

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <!-- ITEM FLAWS -->

  <div class="weapon-trait-block">

    <h3>{{localize "SDP.ItemFlaws"}}</h3>

    <div class="weapon-traits-grid">

      {{#each negativeItemTraits}}

      <div class="trait-row" title="{{localize this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.itemTraits.{{this.key}}.selected"
            {{checked this.checked}}>

          <span class="trait-name">
            {{localize this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.itemTraits.{{this.key}}.value"
          value="{{this.value}}">

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

</div>

{{/if}}

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
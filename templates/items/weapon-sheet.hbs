<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">
    Description
  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">
    Details
  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">
    Effects
  </button>

</nav>

{{#if (eq activeTab "details")}}

<!-- ========================= -->
<!-- CORE -->
<!-- ========================= -->

<div class="weapon-card">

  <div class="weapon-card-title">
    Core
  </div>

  <div class="weapon-grid">

    <div class="form-group">
      <label>Category</label>

      <select name="system.category">
        {{selectOptions categoryOptions selected=system.category}}
      </select>
    </div>

    <div class="form-group">
      <label>Attack Type</label>

      <select name="system.damageType">
        {{#each damageTypeOptions}}
          <option value="{{this.value}}"
            {{#if (eq ../system.damageType this.value)}}selected{{/if}}>
            {{this.label}}
          </option>
        {{/each}}
      </select>
    </div>

    <div class="form-group full-width">
      <label>Skill</label>

      <input
        type="text"
        name="system.skill"
        value="{{system.skill}}" />
    </div>

    <div class="form-group full-width">
      <label>Weapon Group</label>

      <input
        type="text"
        name="system.weaponGroup"
        value="{{system.weaponGroup}}" />
    </div>

  </div>

</div>

<!-- ========================= -->
<!-- COMBAT -->
<!-- ========================= -->

<div class="weapon-card">

  <div class="weapon-card-title">
    Combat
  </div>

  <div class="weapon-grid">

    <div class="form-group">
      <label>Damage Bonus</label>

      <input
        type="text"
        name="system.damage"
        value="{{system.damage}}">
    </div>

    <div class="form-group">
      <label>Damage Dice</label>

      <input
        type="text"
        name="system.damageDice"
        value="{{system.damageDice}}">
    </div>

  </div>

</div>

<!-- ========================= -->
<!-- HANDLING -->
<!-- ========================= -->

<div class="weapon-card">

  <div class="weapon-card-title">
    Handling
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">
      <input
        type="checkbox"
        name="system.offhand"
        {{checked system.offhand}} />

      <label>Offhand</label>
    </div>

    <div class="form-group">
      <label>Handedness</label>

      <select name="system.handedness">
        {{selectOptions handednessOptions selected=system.handedness}}
      </select>
    </div>

    {{#if (eq system.category "melee")}}

    <div class="compact-checkbox">
      <input
        type="checkbox"
        name="system.isDefenseWeapon"
        {{checked system.isDefenseWeapon}}>

      <label>Defense Weapon</label>
    </div>

    {{/if}}

    <div class="compact-checkbox">
      <input
        type="checkbox"
        name="system.equipped"
        {{checked system.equipped}} />

      <label>Equipped</label>
    </div>

    <div class="form-group full-width">
      <label>Durability</label>

      <div class="inline-fields">

        <input
          type="number"
          name="system.durability.value"
          value="{{system.durability.value}}">

        <span>/</span>

        <input
          type="number"
          name="system.durability.max"
          value="{{system.durability.max}}">

      </div>

    </div>

  </div>

</div>

<!-- ========================= -->
<!-- RANGED -->
<!-- ========================= -->

{{#if (eq system.category "ranged")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Ranged
  </div>

  <div class="weapon-grid">

    <div class="form-group">
      <label>Range</label>

      <input
        type="number"
        name="system.range"
        value="{{system.range}}">
    </div>

    <div class="form-group full-width">
      <label>Ammunition Group</label>

      <input
        type="text"
        name="system.ammunitionGroup"
        value="{{system.ammunitionGroup}}">
    </div>

    <div class="compact-checkbox">
      <input
        type="checkbox"
        name="system.consumesAmmo"
        {{checked system.consumesAmmo}}>

      <label>Consumes Ammo</label>
    </div>

    <div class="compact-checkbox">
      <input
        type="checkbox"
        name="system.forceReload"
        {{checked system.forceReload}}>

      <label>Force Reload</label>
    </div>

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- TRAITS -->
<!-- ========================= -->

<div class="weapon-traits-layout">

  <!-- ADVANTAGES -->

  <div class="weapon-trait-block">

    <h3>Advantages</h3>

    <div class="weapon-traits-grid">

      {{#each positiveTraits}}

      <div class="trait-row" title="{{this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.traits.{{this.key}}.selected"
            {{checked this.checked}} />

          <span class="trait-name">
            {{this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <!-- DRAWBACKS -->

  <div class="weapon-trait-block">

    <h3>Drawbacks</h3>

    <div class="weapon-traits-grid">

      {{#each negativeTraits}}

      <div class="trait-row" title="{{this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.traits.{{this.key}}.selected"
            {{checked this.checked}} />

          <span class="trait-name">
            {{this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.traits.{{this.key}}.value"
          value="{{this.value}}"
          placeholder="0" />

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <!-- ========================= -->
<!-- ITEM TRAITS -->
<!-- ========================= -->

  <!-- ITEM TRAITS -->

  <div class="weapon-trait-block">

    <h3>Item Traits</h3>

    <div class="weapon-traits-grid">

      {{#each positiveItemTraits}}

      <div class="trait-row" title="{{this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.itemTraits.{{this.key}}.selected"
            {{checked this.checked}}>

          <span class="trait-name">
            {{this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.itemTraits.{{this.key}}.value"
          value="{{this.value}}">

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

  <!-- ITEM FLAWS -->

  <div class="weapon-trait-block">

    <h3>Item Flaws</h3>

    <div class="weapon-traits-grid">

      {{#each negativeItemTraits}}

      <div class="trait-row" title="{{this.description}}">

        <label class="trait-label">

          <input
            type="checkbox"
            name="system.itemTraits.{{this.key}}.selected"
            {{checked this.checked}}>

          <span class="trait-name">
            {{this.label}}
          </span>

        </label>

        {{#if this.hasValue}}

        <input
          type="text"
          class="trait-value"
          name="system.itemTraits.{{this.key}}.value"
          value="{{this.value}}">

        {{/if}}

      </div>

      {{/each}}

    </div>

  </div>

</div>

{{/if}}

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    Effects

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Spell
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Magic Type</label>

      <select name="system.magicType.value">

        <option
          value="minor"
          {{#if (eq system.magicType.value "minor")}}
            selected
          {{/if}}>

          Minor

        </option>

        <option
          value="advanced"
          {{#if (eq system.magicType.value "advanced")}}
            selected
          {{/if}}>

          Advanced

        </option>

        <option
          value="superior"
          {{#if (eq system.magicType.value "superior")}}
            selected
          {{/if}}>

          Superior

        </option>

      </select>

    </div>

    <div class="form-group">

      <label>Power</label>

      <input
        type="number"
        name="system.power.value"
        value="{{system.power.value}}">

    </div>

    <div class="form-group full-width">

      <label>Magic</label>

      <input
        type="text"
        name="system.magic.value"
        value="{{system.magic.value}}">

    </div>

    <div class="form-group full-width">

      <label>Range</label>

      <input
        type="text"
        name="system.range.value"
        value="{{system.range.value}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Duration
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.concentration.value"
        {{checked system.concentration.value}}>

      <label>Concentration</label>

    </div>

    {{#unless system.concentration.value}}

    <div class="form-group">

      <label>Duration</label>

      <input
        type="text"
        name="system.duration.value"
        value="{{system.duration.value}}">

    </div>

    <div class="form-group">

      <label>Type</label>

      <select name="system.duration.type">

        {{selectOptions
          durationOptions
          selected=system.duration.type}}

      </select>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.duration.extendable"
        {{checked system.duration.extendable}}>

      <label>Extendable</label>

    </div>

    {{/unless}}

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Target
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.aoe.value"
        {{checked system.aoe.value}}>

      <label>Area of Effect</label>

    </div>

    {{#if system.aoe.value}}

    <div class="form-group">

      <label>Radius</label>

      <input
        type="text"
        name="system.radius.value"
        value="{{system.radius.value}}">

    </div>

    {{else}}

    <div class="form-group">

      <label>Targets</label>

      <input
        type="number"
        name="system.target.value"
        value="{{system.target.value}}">

    </div>

    {{/if}}

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Damage
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Base</label>

      <input
        type="number"
        name="system.damage.base.value"
        value="{{system.damage.base.value}}">

    </div>

    <div class="form-group">

      <label>Dice</label>

      <input
        type="text"
        name="system.damage.dice.value"
        value="{{system.damage.dice.value}}">

    </div>

  </div>

</div>

<div class="weapon-card overcast-card">

  <div class="weapon-card-title overcast-header">

    <span>Overcast</span>

    <button
      type="button"
      class="effect-create-button add-overcast-special">

      ✚ Add Effect

    </button>

  </div>

  <div class="overcast-special-list">

    {{#if system.overcastSpecialEffects.value.length}}

      {{#each system.overcastSpecialEffects.value as |effect i|}}

      <div
        class="overcast-special-item"
        data-index="{{i}}">

        <div class="overcast-fields">

          <div class="form-group">

            <label>Effect</label>

            <input
              type="text"
              name="system.overcastSpecialEffects.value.{{@index}}.label"
              value="{{this.label}}"
              placeholder="Burning Radius">

          </div>

          <div class="form-group">

            <label>Formula</label>

            <input
              type="text"
              name="system.overcastSpecialEffects.value.{{@index}}.value"
              value="{{this.value}}"
              placeholder="WPB">

          </div>

        </div>

        <button
          type="button"
          class="remove-overcast-special">

          ✖

        </button>

      </div>

      {{/each}}

    {{else}}

      <div class="empty-overcast">

        No overcast effects yet

      </div>

    {{/if}}

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
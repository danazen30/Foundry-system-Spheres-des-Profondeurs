<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    {{localize "SDP.Effects"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.spell"}}
  </div>

  <div class="weapon-grid">

    {{#if isGM}}
    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>
    {{/if}}

    <div class="form-group">

      <label>{{localize "SDP.MagicType"}}</label>

      <select name="system.magicType.value">

        <option
          value="minor"
          {{#if (eq system.magicType.value "minor")}}
            selected
          {{/if}}>

          {{localize "SDP.MagicMinor"}}

        </option>

        <option
          value="advanced"
          {{#if (eq system.magicType.value "advanced")}}
            selected
          {{/if}}>

          {{localize "SDP.MagicAdvanced"}}

        </option>

        <option
          value="superior"
          {{#if (eq system.magicType.value "superior")}}
            selected
          {{/if}}>

          {{localize "SDP.MagicSuperior"}}

        </option>

      </select>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Power"}}</label>

      <input
        type="number"
        name="system.power.value"
        value="{{system.power.value}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Magic"}}</label>

      <input
        type="text"
        name="system.magic.value"
        value="{{system.magic.value}}">

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.Range"}}</label>

      <input
        type="text"
        name="system.range.value"
        value="{{system.range.value}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Duration"}}
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.concentration.value"
        {{checked system.concentration.value}}>

      <label>{{localize "SDP.Concentration"}}</label>

    </div>

    {{#if system.concentration.value}}

    <div class="form-group">

      <label>{{localize "SDP.Movable"}}</label>

      <input
        type="text"
        name="system.movable.value"
        value="{{system.movable.value}}">

    </div>

    {{/if}}

    {{#unless system.concentration.value}}

    <div class="form-group">

      <label>{{localize "SDP.Duration"}}</label>

      <input
        type="text"
        name="system.duration.value"
        value="{{system.duration.value}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Type"}}</label>

      <select name="system.duration.type">

        {{selectOptions
          durationOptions
          selected=system.duration.type}}

      </select>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.duration.extendable"
        {{checked system.duration.extendable}}>

      <label>{{localize "SDP.Extendable"}}</label>

    </div>

    {{/unless}}

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Target"}}
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.aoe.value"
        {{checked system.aoe.value}}>

      <label>{{localize "SDP.AreaOfEffect"}}</label>

    </div>

    {{#if system.aoe.value}}

    <div class="form-group">

      <label>{{localize "SDP.Radius"}}</label>

      <input
        type="text"
        name="system.radius.value"
        value="{{system.radius.value}}">

    </div>

    {{else}}

    <div class="form-group">

      <label>{{localize "SDP.Targets"}}</label>

      <input
        type="number"
        name="system.target.value"
        value="{{system.target.value}}">

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.lockTargets.value"
        {{checked system.lockTargets.value}}>

      <label>{{localize "SDP.LockTargets"}}</label>

    </div>

    {{/if}}

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Damage"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>{{localize "SDP.Base"}}</label>

      <input
        type="text"
        name="system.damage.base.value"
        value="{{system.damage.base.value}}"
        title="{{localize "SDP.WeaponDamageHint"}}"
        placeholder="WPB, SB, 4">

    </div>

      <div class="form-group">

      <label>{{localize "SDP.Dice"}}</label>

      <input
        type="text"
        name="system.damage.dice.value"
        value="{{system.damage.dice.value}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.AttackType"}}</label>

      <select name="system.damageType">

        {{#each damageTypeOptions}}
          <option
            value="{{this.value}}"
            {{#if (eq ../system.damageType this.value)}}selected{{/if}}>
            {{this.label}}
          </option>
        {{/each}}

      </select>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.ignoreArmor"
        {{checked system.ignoreArmor}}>

      <label>{{localize "SDP.IgnoreArmor"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.resolveMacro"
        {{checked system.resolveMacro}}>

      <label>{{localize "SDP.SpellResolveMacro"}}</label>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.SpellHitLocationMode"}}</label>

      <select name="system.hitLocationMode.value" data-spell-hit-location-mode>

        <option
          value="random"
          {{#if (eq system.hitLocationMode.value "random")}}selected{{/if}}>
          {{localize "SDP.SpellHitLocationRandom"}}
        </option>

        <option
          value="fixed"
          {{#if (eq system.hitLocationMode.value "fixed")}}selected{{/if}}>
          {{localize "SDP.SpellHitLocationFixed"}}
        </option>

      </select>

    </div>

    <div class="form-group spell-fixed-hit-location" style="{{#unless (eq system.hitLocationMode.value "fixed")}}display:none;{{/unless}}">

      <label>{{localize "SDP.SpellFixedHitLocation"}}</label>

      <select name="system.fixedHitLocation.value">

        {{#each hitLocationOptions}}
          <option
            value="{{this.value}}"
            {{#if (eq ../system.fixedHitLocation.value this.value)}}selected{{/if}}>
            {{localize this.label}}
          </option>
        {{/each}}

      </select>

    </div>

  </div>

</div>

<div class="weapon-card overcast-card">

  <div class="weapon-card-title overcast-header">

    <span>{{localize "SDP.Overcast"}}</span>

    <button
      type="button"
      class="effect-create-button add-overcast-special">

      ✚ {{localize "SDP.AddEffect"}}

    </button>

  </div>

  <div class="overcast-special-list">

    {{#if overcastSpecialEffects.length}}

      {{#each overcastSpecialEffects as |effect i|}}

      <div
        class="overcast-special-item"
        data-index="{{i}}">

        <div class="overcast-fields">

          <div class="form-group">

            <label>{{localize "SDP.Effect"}}</label>

            <input
              type="text"
              name="system.overcastSpecialEffects.value.{{@index}}.label"
              value="{{effect.label}}"
              placeholder="{{localize 'SDP.OvercastEffectPlaceholder'}}">

          </div>

          <div class="form-group">

            <label>{{localize "SDP.OvercastStart"}}</label>

            <input
              type="text"
              name="system.overcastSpecialEffects.value.{{@index}}.start"
              value="{{effect.start}}"
              placeholder="0">

          </div>

          <div class="form-group">

            <label>{{localize "SDP.OvercastIncrement"}}</label>

            <input
              type="text"
              name="system.overcastSpecialEffects.value.{{@index}}.value"
              value="{{effect.value}}"
              placeholder="1">

          </div>

        </div>

        <button
          type="button"
          class="remove-overcast-special">

          ✖

        </button>

      </div>

      {{/each}}

    {{else}}

      <div class="empty-overcast">

        {{localize "SDP.NoOvercastEffects"}}

      </div>

    {{/if}}

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
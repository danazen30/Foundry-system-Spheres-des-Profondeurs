<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    Effects

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Container
  </div>

  <div class="weapon-grid">

    <div class="form-group">

    <div class="form-group">

      <label>Capacity</label>

      <input
        type="number"
        name="system.capacity.value"
        value="{{system.capacity.value}}">

    </div>

    <div class="form-group">

      <label>Reduction</label>

      <input
        type="number"
        step="0.1"
        name="system.reduction.value"
        value="{{system.reduction.value}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
  </div>

  <div class="weapon-traits-layout">

    <!-- POSITIVE -->

    <div class="weapon-trait-block">

      <h3>Positive Traits</h3>

      <div class="weapon-traits-grid">

        {{#each positiveItemTraits}}

        <label class="trait-row">

          <span class="trait-label">

            <input
              type="checkbox"
              name="system.itemTraits"
              value="{{this.key}}"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </span>

        </label>

        {{/each}}

      </div>

    </div>

    <!-- NEGATIVE -->

    <div class="weapon-trait-block">

      <h3>Negative Traits</h3>

      <div class="weapon-traits-grid">

        {{#each negativeItemTraits}}

        <label class="trait-row">

          <span class="trait-label">

            <input
              type="checkbox"
              name="system.itemTraits"
              value="{{this.key}}"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </span>

        </label>

        {{/each}}

      </div>

    </div>

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
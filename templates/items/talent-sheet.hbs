<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

<button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    Effects

  </button>

</nav>

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Talent
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Advances</label>

      <input
        type="number"
        name="system.advances"
        value="{{system.advances}}" />

    </div>

    <div class="form-group">

      <label>Max Advances</label>

      <input
        type="text"
        name="system.max"
        value="{{system.max}}" />

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.canAdvance"
        {{checked system.canAdvance}}>

      <label>Can Advance</label>

    </div>

  </div>

</div>

{{#if user.isGM}}

<div class="weapon-card">

  <div class="weapon-card-title">
    GM Notes
  </div>

  <div
    class="note-display"
    data-display="gmNotes">

    {{{editors.gmNotes}}}

  </div>

  <div
    class="note-editor"
    data-editor="gmNotes"
    style="display:none;">

    <prose-mirror
      name="system.gmNotes"
      value="{{system.gmNotes}}">

      {{{system.gmNotes}}}

    </prose-mirror>

  </div>

  <button
    type="button"
    class="note-edit-btn"
    data-action="toggleEditor"
    data-target="gmNotes">

    ✏️ Edit

  </button>

</div>

{{/if}}

{{/if}}

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Description
  </div>

  <div
    class="note-display"
    data-display="description">

    {{{editors.description}}}

  </div>

  <div
    class="note-editor"
    data-editor="description"
    style="display:none;">

    <prose-mirror
      name="system.description"
      value="{{system.description}}">

      {{{system.description}}}

    </prose-mirror>

  </div>

  <button
    type="button"
    class="note-edit-btn"
    data-action="toggleEditor"
    data-target="description">

    ✏️ Edit

  </button>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Player Notes
  </div>

  <div
    class="note-display"
    data-display="playerNotes">

    {{{editors.playerNotes}}}

  </div>

  <div
    class="note-editor"
    data-editor="playerNotes"
    style="display:none;">

    <prose-mirror
      name="system.playerNotes"
      value="{{system.playerNotes}}">

      {{{system.playerNotes}}}

    </prose-mirror>

  </div>

  <button
    type="button"
    class="note-edit-btn"
    data-action="toggleEditor"
    data-target="playerNotes">

    ✏️ Edit

  </button>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

{{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

<button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    {{localize "SDP.Effects"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.talent"}}
  </div>

  <div class="weapon-grid">

    {{#if isGM}}
    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>
    {{/if}}

    <div class="form-group">

      <label>{{localize "SDP.Advances"}}</label>

      <input
        type="number"
        name="system.advances"
        value="{{system.advances}}" />

    </div>

    <div class="form-group">

      <label>{{localize "SDP.MaxAdvances"}}</label>

      <input
        type="text"
        name="system.max"
        value="{{system.max}}" />

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.canAdvance"
        {{checked system.canAdvance}}>

      <label>{{localize "SDP.CanAdvance"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.showInRollDialog"
        {{checked system.showInRollDialog}}>

      <label>{{localize "SDP.ShowInRollDialog"}}</label>

    </div>

  </div>

</div>

{{#if user.isGM}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.GMNotes"}}
  </div>

  <div
    class="note-display"
    data-display="gmNotes">

    {{{editors.gmNotes}}}

  </div>

  <div
    class="note-editor"
    data-editor="gmNotes"
    style="display:none;">

    <prose-mirror
      name="system.gmNotes"
      value="{{system.gmNotes}}">

      {{{system.gmNotes}}}

    </prose-mirror>

  </div>

  <button
    type="button"
    class="note-edit-btn"
    data-action="toggleEditor"
    data-target="gmNotes">

    ✏️ {{localize "SDP.Edit"}}

  </button>

</div>

{{/if}}

{{/if}}

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.TabDescription"}}
  </div>

  <div
    class="note-display"
    data-display="description">

    {{{editors.description}}}

  </div>

  <div
    class="note-editor"
    data-editor="description"
    style="display:none;">

    <prose-mirror
      name="system.description"
      value="{{system.description}}">

      {{{system.description}}}

    </prose-mirror>

  </div>

  <button
    type="button"
    class="note-edit-btn"
    data-action="toggleEditor"
    data-target="description">

    ✏️ {{localize "SDP.Edit"}}

  </button>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.PlayerNotes"}}
  </div>

  <div
    class="note-display"
    data-display="playerNotes">

    {{{editors.playerNotes}}}

  </div>

  <div
    class="note-editor"
    data-editor="playerNotes"
    style="display:none;">

    <prose-mirror
      name="system.playerNotes"
      value="{{system.playerNotes}}">

      {{{system.playerNotes}}}

    </prose-mirror>

  </div>

  <button
    type="button"
    class="note-edit-btn"
    data-action="toggleEditor"
    data-target="playerNotes">

    ✏️ {{localize "SDP.Edit"}}

  </button>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

{{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
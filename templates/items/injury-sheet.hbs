<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    {{localize "SDP.Effects"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.injury"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Severity"}}</label>

      <input
        type="text"
        name="system.severity"
        value="{{system.severity}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Location"}}</label>

      <input
        type="text"
        name="system.location"
        value="{{system.location}}">

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.consequence"
        {{checked system.consequence}}>

      <label>{{localize "SDP.Consequence"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.removeOnDelete"
        {{checked system.removeOnDelete}}>

      <label>{{localize "SDP.RemoveOnDelete"}}</label>

    </div>

    <div class="form-group full-width">

      <label>{{localize "SDP.DurationRounds"}}</label>

      <input
        type="number"
        name="system.duration"
        value="{{system.duration}}">

    </div>

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
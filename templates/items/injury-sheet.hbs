<div class="sdp-item-sheet">

<h1>
  <input type="text" name="name" value="{{item.name}}" />
</h1>

<div class="weapon-img">
  <img src="{{item.img}}" title="{{item.name}}" />
</div>

<!-- ===================== -->
<!-- CORE DATA -->
<!-- ===================== -->

<div class="form-group">
  <label>Severity</label>
  <input type="text" name="system.severity" value="{{system.severity}}">
</div>

<div class="form-group">
  <label>Location</label>
  <input type="text" name="system.location" value="{{system.location}}">
</div>

<div class="form-group">
  <label>Consequence</label>
  <input type="checkbox" name="system.consequence" {{checked system.consequence}}>
</div>

<div class="form-group">
  <label>Duration (rounds)</label>
  <input type="number" name="system.duration" value="{{system.duration}}">
</div>

<div class="form-group">
  <label>Remove on delete</label>
  <input type="checkbox" name="system.removeOnDelete" {{checked system.removeOnDelete}}>
</div>

<!-- ===================== -->
<!-- DESCRIPTION -->
<!-- ===================== -->

<div class="form-group">
  <label>Description</label>
  <textarea name="system.description">{{system.description}}</textarea>
</div>

<div class="form-group">
  <label>Player Notes</label>
  <textarea name="system.playerNotes">{{system.playerNotes}}</textarea>
</div>

<div class="form-group">
  <label>GM Notes</label>
  <textarea name="system.gmNotes">{{system.gmNotes}}</textarea>
</div>

<!-- ===================== -->
<!-- EFFECTS -->
<!-- ===================== -->

<h2>Effects</h2>

<button type="button" data-action="create-effect">
  ➕ Add Effect
</button>

<ol class="effects-list">

  {{#each effects}}

 <li class="effect" data-effect-id="{{this.id}}">

    <div class="effect-name">
      {{this.name}}
    </div>

    <div class="effect-controls">

      <button type="button" data-action="edit-effect">
        ✏️
      </button>

      <button type="button" data-action="delete-effect">
        🗑️
      </button>

    </div>

  </li>

  {{/each}}

</ol>

</div>
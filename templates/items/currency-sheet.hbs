<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Currency
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Type</label>

      <select name="system.denomination.value">

        {{#each denominations}}

        <option
          value="{{this}}"
          {{#if (eq this ../system.denomination.value)}}
            selected
          {{/if}}>

          {{this}}

        </option>

        {{/each}}

      </select>

    </div>

    <div class="form-group">

      <label>Quantity</label>

      <input
        type="number"
        name="system.quantity.value"
        value="{{system.quantity.value}}">

    </div>

    <div class="form-group">

      <label>Weight</label>

      <input
        type="number"
        name="system.encumbrance.value"
        value="{{system.encumbrance.value}}">

    </div>

    <div class="form-group">

      <label>Value</label>

      <input
        type="text"
        name="system.value.value"
        value="{{system.value.value}}">

    </div>

  </div>

</div>

{{/if}}

</div>
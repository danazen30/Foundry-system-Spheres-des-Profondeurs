<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    {{localize "SDP.Effects"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.clothing"}}
  </div>

  <div class="weapon-grid">

    {{#if isGM}}
    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}" />

    </div>
    {{/if}}

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.equipped"
        {{checked system.equipped}}>

      <label>{{localize "SDP.Equipped"}}</label>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Layer"}}</label>

      <input
        type="number"
        name="system.layer"
        value="{{system.layer}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.Slots"}}
  </div>

  <div class="weapon-grid">

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.slots.head"
        {{checked system.slots.head}}>

      <label>{{localize "SDP.HitLocationHead"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.slots.chest"
        {{checked system.slots.chest}}>

      <label>{{localize "SDP.Chest"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.slots.armLeft"
        {{checked system.slots.armLeft}}>

      <label>{{localize "SDP.HitLocationLeftArm"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.slots.armRight"
        {{checked system.slots.armRight}}>

      <label>{{localize "SDP.HitLocationRightArm"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.slots.legLeft"
        {{checked system.slots.legLeft}}>

      <label>{{localize "SDP.HitLocationLeftLeg"}}</label>

    </div>

    <div class="compact-checkbox">

      <input
        type="checkbox"
        name="system.slots.legRight"
        {{checked system.slots.legRight}}>

      <label>{{localize "SDP.HitLocationRightLeg"}}</label>

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "SDP.ItemTraits"}}
  </div>

  <div class="weapon-traits-layout">

    <!-- POSITIVE -->

    <div class="weapon-trait-block">

      <h3>{{localize "SDP.PositiveTraits"}}</h3>

      <div class="weapon-traits-grid">

        {{#each positiveItemTraits}}

        <label class="trait-row">

          <span class="trait-label">

            <input
              type="checkbox"
              name="system.itemTraits"
              value="{{this.key}}"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </span>

        </label>

        {{/each}}

      </div>

    </div>

    <!-- NEGATIVE -->

    <div class="weapon-trait-block">

      <h3>{{localize "SDP.NegativeTraits"}}</h3>

      <div class="weapon-traits-grid">

        {{#each negativeItemTraits}}

        <label class="trait-row">

          <span class="trait-label">

            <input
              type="checkbox"
              name="system.itemTraits"
              value="{{this.key}}"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </span>

        </label>

        {{/each}}

      </div>

    </div>

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
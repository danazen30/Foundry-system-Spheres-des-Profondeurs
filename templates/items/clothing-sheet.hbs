<div class="sdp-item-sheet">

  <label>Name</label>
  <input type="text" name="name" value="{{item.name}}" />

<div class="clothing-img">
  <img src="{{item.img}}" title="{{item.name}}" />
</div>
  <label>Equipped</label>
  <input type="checkbox" name="system.equipped" {{checked system.equipped}} />

  <label>Quantity</label>
  <input type="number" name="system.quantity.value" value="{{system.quantity.value}}" />

  <label>Weight</label>
  <input type="number" name="system.encumbrance.value" value="{{system.encumbrance.value}}" />

  <label>Price</label>
  <input type="number" name="system.price.po" value="{{system.price.po}}" />

  <h2>Slots</h2>

<div class="form-group">
  <label>Head</label>
  <input type="checkbox" name="system.slots.head" {{checked system.slots.head}}>
</div>

<div class="form-group">
  <label>Chest</label>
  <input type="checkbox" name="system.slots.chest" {{checked system.slots.chest}}>
</div>

<div class="form-group">
  <label>Left Arm</label>
  <input type="checkbox" name="system.slots.armLeft" {{checked system.slots.armLeft}}>
</div>

<div class="form-group">
  <label>Right Arm</label>
  <input type="checkbox" name="system.slots.armRight" {{checked system.slots.armRight}}>
</div>

<div class="form-group">
  <label>Left Leg</label>
  <input type="checkbox" name="system.slots.legLeft" {{checked system.slots.legLeft}}>
</div>

<div class="form-group">
  <label>Right Leg</label>
  <input type="checkbox" name="system.slots.legRight" {{checked system.slots.legRight}}>
</div>

<label>Layer</label>
<input type="number" name="system.layer" value="{{system.layer}}">

  <label>Description</label>
  <textarea name="system.description.value">{{system.description.value}}</textarea>

  <hr>

<h3>Active Effects</h3>

<div class="effects-list">
  {{#each item.effects as |effect|}}
    <div class="effect-row" data-effect-id="{{effect.id}}">

      <input type="text" value="{{effect.name}}" disabled />

      <button type="button" data-action="editEffect" data-effect-id="{{effect.id}}">
        Edit
      </button>

      <button type="button" data-action="deleteEffect" data-effect-id="{{effect.id}}">
        Delete
      </button>

    </div>
  {{/each}}
</div>

<button type="button" data-action="createEffect">
  Add Effect
</button>

</div>
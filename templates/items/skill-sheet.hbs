<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-simple.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    {{localize "SDP.TabDescription"}}

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    {{localize "SDP.TabDetails"}}

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    {{localize "TYPES.Item.skill"}}
  </div>

  <div class="weapon-grid">

    <div class="form-group full-width">

      <label>{{localize "SDP.Key"}}</label>

      <input
        type="text"
        name="system.key"
        value="{{system.key}}">

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Characteristic"}}</label>

      <select name="system.characteristic">

        {{selectOptions
          characteristicOptions
          selected=system.characteristic}}

      </select>

    </div>

    <div class="form-group">

      <label>{{localize "SDP.Type"}}</label>

      <select name="system.advanced">

        <option
          value="false"
          {{#unless system.advanced}}
            selected
          {{/unless}}>

          {{localize "SDP.Basic"}}

        </option>

        <option
          value="true"
          {{#if system.advanced}}
            selected
          {{/if}}>

          {{localize "SDP.Advanced"}}

        </option>

      </select>

    </div>

  </div>

</div>

{{/if}}

</div>
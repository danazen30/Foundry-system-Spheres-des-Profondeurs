<div class="sdp-item-sheet">

<h1>
  <input type="text" name="name" value="{{item.name}}" />
</h1>

<h2>Skill</h2>

<div class="form-group">
  <label>Key</label>
  <input type="text" name="system.key" value="{{system.key}}">
</div>

<div class="form-group">
  <label>Characteristic</label>
  <select name="system.characteristic">
    {{selectOptions characteristicOptions selected=system.characteristic}}
  </select>
</div>

<div class="form-group">
  <label>Type</label>

  <select name="system.advanced">
    <option value="false" {{#unless system.advanced}}selected{{/unless}}>
      Basic
    </option>

    <option value="true" {{#if system.advanced}}selected{{/if}}>
      Advanced
    </option>
  </select>
</div>

<div class="form-group">
  <label>Modifier</label>
  <input type="number" name="system.modifier" value="{{system.modifier}}">
</div>

<div class="form-group">
  <label>Description</label>
  <textarea name="system.description">{{system.description}}</textarea>
</div>

</div>
<div class="sdp-item-sheet">

<h1>
  <input type="text" name="name" value="{{item.name}}" />
</h1>

<div class="form-group">
  <label>Quantity</label>
  <input type="number" name="system.quantity.value" value="{{system.quantity.value}}">
</div>

<label>Weight</label>
<input type="number" name="system.encumbrance.value" value="{{system.encumbrance.value}}" step="0.1">

<div class="form-group">
  <label>Worn</label>
  <input type="checkbox" name="system.worn.value" {{checked system.worn.value}}>
</div>

<h2>Armor Points</h2>

<div class="form-group">
  <label>Head</label>
  <input type="number" name="system.AP.head" value="{{system.AP.head}}">
</div>

<div class="form-group">
  <label>Body</label>
  <input type="number" name="system.AP.body" value="{{system.AP.body}}">
</div>

<div class="form-group">
  <label>Left Arm</label>
  <input type="number" name="system.AP.leftArm" value="{{system.AP.leftArm}}">
</div>

<div class="form-group">
  <label>Right Arm</label>
  <input type="number" name="system.AP.rightArm" value="{{system.AP.rightArm}}">
</div>

<div class="form-group">
  <label>Left Leg</label>
  <input type="number" name="system.AP.leftLeg" value="{{system.AP.leftLeg}}">
</div>

<div class="form-group">
  <label>Right Leg</label>
  <input type="number" name="system.AP.rightLeg" value="{{system.AP.rightLeg}}">
</div>

<div class="form-group">
  <label>Durability</label>
  <input type="number" name="system.durability.value" value="{{system.durability.value}}">
  /
  <input type="number" name="system.durability.max" value="{{system.durability.max}}">
</div>

<!-- ===================== -->
<!-- ARMOR TRAITS -->
<!-- ===================== -->

<h2>Armor Traits</h2>

<div class="traits-list">

  <h3>Advantages</h3>

  {{#each positiveArmorTraits}}
  <div class="trait-row" title="{{this.description}}">

    <label>
      <input type="checkbox"
        name="system.armorTraits.{{this.key}}.selected"
        {{checked this.checked}}>

      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
        class="trait-value"
        name="system.armorTraits.{{this.key}}.value"
        value="{{this.value}}">
    {{/if}}

  </div>
  {{/each}}

  <h3>Drawbacks</h3>

  {{#each negativeArmorTraits}}
  <div class="trait-row" title="{{this.description}}">

    <label>
      <input type="checkbox"
        name="system.armorTraits.{{this.key}}.selected"
        {{checked this.checked}}>

      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
        class="trait-value"
        name="system.armorTraits.{{this.key}}.value"
        value="{{this.value}}">
    {{/if}}

  </div>
  {{/each}}

</div>

<!-- ===================== -->
<!-- ITEM TRAITS (GLOBAL) -->
<!-- ===================== -->

<h2>Item Traits</h2>

<div class="traits-list">

  <h3>Advantages</h3>

  {{#each positiveItemTraits}}
  <div class="trait-row" title="{{this.description}}">

    <label>
      <input type="checkbox"
        name="system.itemTraits.{{this.key}}.selected"
        {{checked this.checked}}>

      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
        class="trait-value"
        name="system.itemTraits.{{this.key}}.value"
        value="{{this.value}}">
    {{/if}}

  </div>
  {{/each}}

  <h3>Drawbacks</h3>

  {{#each negativeItemTraits}}
  <div class="trait-row" title="{{this.description}}">

    <label>
      <input type="checkbox"
        name="system.itemTraits.{{this.key}}.selected"
        {{checked this.checked}}>

      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
        class="trait-value"
        name="system.itemTraits.{{this.key}}.value"
        value="{{this.value}}">
    {{/if}}

  </div>
  {{/each}}

</div>

<!-- ===================== -->
<!-- EFFECTS -->
<!-- ===================== -->

<h2>Effects</h2>

<button type="button" data-action="create-effect">
  ➕ Add Effect
</button>

<ol class="effects-list">

  {{#each effects}}
  <li class="effect flexrow" data-effect-id="{{this.id}}">

    <div class="effect-name">
      {{this.name}}
    </div>

    <div class="effect-controls">

      <button type="button" data-action="edit-effect">
        ✏️
      </button>

      <button type="button" data-action="delete-effect">
        🗑️
      </button>

    </div>

  </li>
  {{/each}}

</ol>

</div>
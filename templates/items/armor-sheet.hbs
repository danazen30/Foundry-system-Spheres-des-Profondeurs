<div class="sdp-item-sheet">

{{> "systems/sdp/templates/partials/items/item-header-physical.hbs"}}

<!-- ========================= -->
<!-- TABS -->
<!-- ========================= -->

<nav class="item-tabs">

  <button
    type="button"
    data-tab="description"
    class="{{#if (eq activeTab 'description')}}active{{/if}}">

    Description

  </button>

  <button
    type="button"
    data-tab="details"
    class="{{#if (eq activeTab 'details')}}active{{/if}}">

    Details

  </button>

  <button
    type="button"
    data-tab="effects"
    class="{{#if (eq activeTab 'effects')}}active{{/if}}">

    Effects

  </button>

</nav>

<!-- ========================= -->
<!-- DESCRIPTION -->
<!-- ========================= -->

{{#if (eq activeTab "description")}}

  {{> "systems/sdp/templates/partials/items/item-description-tab.hbs"}}

{{/if}}

<!-- ========================= -->
<!-- DETAILS -->
<!-- ========================= -->

{{#if (eq activeTab "details")}}

<div class="weapon-card">

  <div class="weapon-card-title">
    Armor
  </div>

  <div class="weapon-grid">

    <div class="form-group">

      <label>Worn</label>

      <input
        type="checkbox"
        name="system.worn.value"
        {{checked system.worn.value}}>

    </div>

    <div class="form-group">

      <label>Layer</label>

      <input
        type="number"
        name="system.layer"
        value="{{system.layer}}">

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Armor Points
  </div>

  <div class="weapon-grid">

    <div class="form-group">
      <label>Head</label>
      <input type="number" name="system.AP.head" value="{{system.AP.head}}">
    </div>

    <div class="form-group">
      <label>Body</label>
      <input type="number" name="system.AP.body" value="{{system.AP.body}}">
    </div>

    <div class="form-group">
      <label>Left Arm</label>
      <input type="number" name="system.AP.leftArm" value="{{system.AP.leftArm}}">
    </div>

    <div class="form-group">
      <label>Right Arm</label>
      <input type="number" name="system.AP.rightArm" value="{{system.AP.rightArm}}">
    </div>

    <div class="form-group">
      <label>Left Leg</label>
      <input type="number" name="system.AP.leftLeg" value="{{system.AP.leftLeg}}">
    </div>

    <div class="form-group">
      <label>Right Leg</label>
      <input type="number" name="system.AP.rightLeg" value="{{system.AP.rightLeg}}">
    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Durability
  </div>

  <div class="inline-fields">

    <input
      type="number"
      name="system.durability.value"
      value="{{system.durability.value}}">

    <span>/</span>

    <input
      type="number"
      name="system.durability.max"
      value="{{system.durability.max}}">

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Slots
  </div>

  <div class="weapon-grid">

    <label class="compact-checkbox">
      <input type="checkbox" name="system.slots.head" {{checked system.slots.head}}>
      Head
    </label>

    <label class="compact-checkbox">
      <input type="checkbox" name="system.slots.chest" {{checked system.slots.chest}}>
      Chest
    </label>

    <label class="compact-checkbox">
      <input type="checkbox" name="system.slots.armLeft" {{checked system.slots.armLeft}}>
      Left Arm
    </label>

    <label class="compact-checkbox">
      <input type="checkbox" name="system.slots.armRight" {{checked system.slots.armRight}}>
      Right Arm
    </label>

    <label class="compact-checkbox">
      <input type="checkbox" name="system.slots.legLeft" {{checked system.slots.legLeft}}>
      Left Leg
    </label>

    <label class="compact-checkbox">
      <input type="checkbox" name="system.slots.legRight" {{checked system.slots.legRight}}>
      Right Leg
    </label>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Armor Traits
  </div>

  <div class="weapon-traits-layout">

    <div class="weapon-trait-block">

      <h3>Advantages</h3>

      <div class="weapon-traits-grid">

        {{#each positiveArmorTraits}}

        <div
          class="trait-row"
          title="{{this.description}}">

          <div class="trait-label">

            <input
              type="checkbox"
              name="system.armorTraits.{{this.key}}.selected"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </div>

          {{#if this.hasValue}}

          <input
            type="text"
            class="trait-value"
            name="system.armorTraits.{{this.key}}.value"
            value="{{this.value}}">

          {{/if}}

        </div>

        {{/each}}

      </div>

    </div>

    <div class="weapon-trait-block">

      <h3>Drawbacks</h3>

      <div class="weapon-traits-grid">

        {{#each negativeArmorTraits}}

        <div
          class="trait-row"
          title="{{this.description}}">

          <div class="trait-label">

            <input
              type="checkbox"
              name="system.armorTraits.{{this.key}}.selected"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </div>

          {{#if this.hasValue}}

          <input
            type="text"
            class="trait-value"
            name="system.armorTraits.{{this.key}}.value"
            value="{{this.value}}">

          {{/if}}

        </div>

        {{/each}}

      </div>

    </div>

  </div>

</div>

<div class="weapon-card">

  <div class="weapon-card-title">
    Item Traits
  </div>

  <div class="weapon-traits-layout">

    <div class="weapon-trait-block">

      <h3>Advantages</h3>

      <div class="weapon-traits-grid">

        {{#each positiveItemTraits}}

        <div
          class="trait-row"
          title="{{this.description}}">

          <div class="trait-label">

            <input
              type="checkbox"
              name="system.itemTraits.{{this.key}}.selected"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </div>

          {{#if this.hasValue}}

          <input
            type="text"
            class="trait-value"
            name="system.itemTraits.{{this.key}}.value"
            value="{{this.value}}">

          {{/if}}

        </div>

        {{/each}}

      </div>

    </div>

    <div class="weapon-trait-block">

      <h3>Drawbacks</h3>

      <div class="weapon-traits-grid">

        {{#each negativeItemTraits}}

        <div
          class="trait-row"
          title="{{this.description}}">

          <div class="trait-label">

            <input
              type="checkbox"
              name="system.itemTraits.{{this.key}}.selected"
              {{checked this.checked}}>

            <span class="trait-name">
              {{this.label}}
            </span>

          </div>

          {{#if this.hasValue}}

          <input
            type="text"
            class="trait-value"
            name="system.itemTraits.{{this.key}}.value"
            value="{{this.value}}">

          {{/if}}

        </div>

        {{/each}}

      </div>

    </div>

  </div>

</div>

{{/if}}

<!-- ========================= -->
<!-- EFFECTS -->
<!-- ========================= -->

{{#if (eq activeTab "effects")}}

  {{> "systems/sdp/templates/partials/items/item-effects-tab.hbs"}}

{{/if}}

</div>
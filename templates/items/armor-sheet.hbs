<div class="sdp-item-sheet">

<h2>{{item.name}}</h2>

<div class="armor-main">

<label>Armor Type</label>
<input
type="text"
name="system.armorType.value"
value="{{system.armorType.value}}">

<label>Worn</label>
<input
type="checkbox"
name="system.worn.value"
{{checked system.worn.value}}>

</div>

<h3>Armor Points</h3>

<div class="armor-grid">

<label>Head</label>
<input type="number" name="system.AP.head" value="{{system.AP.head}}">

<label>Body</label>
<input type="number" name="system.AP.body" value="{{system.AP.body}}">

<label>Left Arm</label>
<input type="number" name="system.AP.leftArm" value="{{system.AP.leftArm}}">

<label>Right Arm</label>
<input type="number" name="system.AP.rightArm" value="{{system.AP.rightArm}}">

<label>Left Leg</label>
<input type="number" name="system.AP.leftLeg" value="{{system.AP.leftLeg}}">

<label>Right Leg</label>
<input type="number" name="system.AP.rightLeg" value="{{system.AP.rightLeg}}">

</div>

<div class="form-group">
  <label>Durability</label>
  <input type="number" name="system.durability.value" value="{{system.durability.value}}">
  /
  <input type="number" name="system.durability.max" value="{{system.durability.max}}">
</div>

<h3>Armor Traits</h3>

<div class="traits">

  {{#each armorTraits}}
    <label>
      <input type="checkbox"
       name="system.armorTraits.{{key}}.selected"
       {{#if checked}}checked{{/if}} />

      {{label}}

      {{#if hasValue}}
        <input type="text" name="system.armorTraits.{{key}}.value" value="{{value}}" />
      {{/if}}

    </label>
  {{/each}}

</div>

<h3>Item Traits</h3>

{{#each positiveItemTraits}}
  <div class="trait">

    <label>
      <input type="checkbox"
             name="system.itemTraits.{{this.key}}.selected"
             {{#if this.checked}}checked{{/if}}>
      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
      class="trait-value"
             name="system.itemTraits.{{this.key}}.value"
             value="{{this.value}}">
    {{/if}}

  </div>
{{/each}}

<h3>Item Flaws</h3>

{{#each negativeItemTraits}}
  <div class="trait">

    <label>
      <input type="checkbox"
             name="system.itemTraits.{{this.key}}.selected"
             {{#if this.checked}}checked{{/if}}>
      {{this.label}}
    </label>

    {{#if this.hasValue}}
      <input type="text"
      class="trait-value"
             name="system.itemTraits.{{this.key}}.value"
             value="{{this.value}}">
    {{/if}}

  </div>
{{/each}}

<h3>Effects</h3>

<ul>
  {{#each effects}}
    <li class="effect" data-effect-id="{{this.id}}">
      {{this.name}}
      <button data-action="edit-effect">Edit</button>
      <button data-action="delete-effect">Delete</button>
    </li>
  {{/each}}
</ul>

<button data-action="create-effect">Add Effect</button>

</div>
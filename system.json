{
  "id": "sdp",
  "title": "Spheres of the Depths",
  "description": "A custom tabletop RPG system for Foundry VTT",
  "version": "0.0.1",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Danazen"
    }
  ],
  "esmodules": [
    "module/sdp.js"
  ],
  "styles": [
    "styles/sdp.css",
    "styles/sheets.css",
    "styles/item-sheets.css"
  ],


  "url": "https://github.com/danazen30/Foundry-system-Spheres-des-Profondeurs",
  "manifest": "",
  "download": "",
  "socket": true,

  "initiative": "1d20 + @attributes.initiative.value",

  "packs": [

    {
      "name": "injuries",
      "label": "SDP Injuries",
      "system": "sdp",
      "path": "packs/injuries",
      "type": "Item",
      "banner": "systems/sdp/assets/icons/default-banner.png"
    },

    {
      "name": "talents",
      "label": "SDP Talents",
      "system": "sdp",
      "path": "packs/talents",
      "type": "Item",
      "banner": "systems/sdp/assets/icons/default-banner.png"
    },

    {
      "name": "skills",
      "label": "SDP Skills",
      "system": "sdp",
      "path": "packs/skills",
      "type": "Item",
      "banner": "systems/sdp/assets/icons/default-banner.png"
    },

    {
      "name": "species",
      "label": "SDP species",
      "system": "sdp",
      "path": "packs/species",
      "type": "Item" ,
      "banner": "systems/sdp/assets/icons/default-banner.png"
    },

    {
      "name": "careers",
      "label": "SDP Careers",
      "system": "sdp",
      "path": "packs/careers",
      "type": "Item",
      "banner": "systems/sdp/assets/icons/default-banner.png"
    },

    {
      "name": "sign",
      "label": "SDP Sign",
      "system": "sdp",
      "path": "packs/sign",
      "type": "Item",
      "banner": "systems/sdp/assets/icons/default-banner.png"
    },

    {
      "name": "possession",
      "label": "SDP Possession Base",
      "system": "sdp",
      "path": "packs/possession",
      "type": "Item",
      "banner": "systems/sdp/assets/icons/default-banner.png"
    }

  ],

  "relationships": {
  "requires": [
    {
      "id": "socketlib",
      "type": "module"
    }
  ]
},

  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value",
          "system.details.personalAmbitions.value",
          "system.details.partyAmbitions.value"
        ]
      },
      "npc": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value"
        ]
      },
      "creature": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value"
        ]
      }
    },
    "Item": {
      "skill": {},
      "talent": {},
      "weapon": {},
      "armor": {},
      "spell": {},
      "injury": {},
      "specie": {},
      "career": {},
      "sign":{},
      "ammunition": {},
      "possession": {},
      "disease": {},
      "trait": {},
      "clothing": {},
      "container": {},
      "currency": {}
    }
  }
}

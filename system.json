{
  "id": "sdp",
  "title": "Spheres of the Depths",
  "description": "A custom tabletop RPG system for Foundry VTT",
  "version": "0.0.1",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Danazen"
    }
  ],
  "esmodules": [
    "module/sdp.js"
  ],
  "styles": [
    "styles/sdp.css",
    "styles/sheets.css",
    "styles/item-sheets.css"
  ],


  "url": "https://github.com/danazen30/Foundry-system-Spheres-des-Profondeurs",
  "manifest": "",
  "download": "",

  "initiative": "1d20 + @attributes.initiative.value",

  "packs": [

    {
      "name": "injuries",
      "label": "SDP Injuries",
      "system": "sdp",
      "path": "packs/injuries",
      "type": "Item"
    },

    {
      "name": "trait",
      "label": "SDP Trait",
      "system": "sdp",
      "path": "packs/trait",
      "type": "Item"
    },

    {
      "name": "talents",
      "label": "SDP Talents",
      "system": "sdp",
      "path": "packs/talents",
      "type": "Item"
    },

    {
      "name": "skills",
      "label": "SDP Skills",
      "system": "sdp",
      "path": "packs/skills",
      "type": "Item"
    },

    {
      "name": "weapons",
      "label": "SDP Weapons",
      "system": "sdp",
      "path": "packs/weapons",
      "type": "Item"
    },

    {
      "name": "species",
      "label": "SDP species",
      "system": "sdp",
      "path": "packs/species",
      "type": "Item" 
    },

    {
      "name": "careers",
      "label": "SDP Careers",
      "system": "sdp",
      "path": "packs/careers",
      "type": "Item"
    },

    {
      "name": "sign",
      "label": "SDP Sign",
      "system": "sdp",
      "path": "packs/sign",
      "type": "Item"
    },

    {
      "name": "spell",
      "label": "SDP Spell",
      "system": "sdp",
      "path": "packs/spell",
      "type": "Item"
    },

    {
      "name": "ammunition",
      "label": "SDP Ammunition",
      "system": "sdp",
      "path": "packs/ammunition",
      "type": "Item"
    },

    {
      "name": "armor",
      "label": "SDP Armor",
      "system": "sdp",
      "path": "packs/armor",
      "type": "Item"
    },

    {
      "name": "possession",
      "label": "SDP Possession",
      "system": "sdp",
      "path": "packs/possession",
      "type": "Item"
    },

    {
      "name": "disease",
      "label": "SDP Disease",
      "system": "sdp",
      "path": "packs/disease",
      "type": "Item"
    },

    {
      "name": "clothing",
      "label": "SDP Clothing",
      "system": "sdp",
      "path": "packs/clothing",
      "type": "Item"
    },

    {
      "name": "container",
      "label": "SDP Container",
      "system": "sdp",
      "path": "packs/container",
      "type": "Item"
    }

  ],

  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value",
          "system.details.personalAmbitions.value",
          "system.details.partyAmbitions.value"
        ]
      },
      "npc": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value"
        ]
      },
      "creature": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value"
        ]
      }
    },
    "Item": {
      "skill": {},
      "talent": {},
      "weapon": {},
      "armor": {},
      "spell": {},
      "injury": {},
      "specie": {},
      "career": {},
      "sign":{},
      "ammunition": {},
      "possession": {},
      "disease": {},
      "trait": {},
      "clothing": {},
      "container": {},
      "currency": {}
    }
  }
}

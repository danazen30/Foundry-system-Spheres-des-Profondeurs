{
  "id": "sdp",
  "title": "Spheres of the Depths",
  "description": "Spheres of the Depths",
  "version": "0.0.1",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "authors": [
    {
      "name": "Danazen"
    }
  ],
  "esmodules": [
    "module/sdp.js"
  ],
  "styles": [
    "styles/sdp.css",
    "styles/sheets.css",
    "styles/item-sheets.css"
  ],


  "url": "https://github.com/danazen30/Foundry-system-Spheres-des-Profondeurs",
  "manifest": "",
  "download": "",
  "socket": true,

  "languages": [
  {
    "lang": "en",
    "name": "English",
    "path": "lang/en.json"
  },
  {
    "lang": "fr",
    "name": "Français",
    "path": "lang/fr.json"
  }
],

  "initiative": "1d20 + @attributes.initiative.value + (@custom.combatInitiativeBonus ?? 0)",

  "packs": [

  {
    "name": "injuries",
    "label": "SDP.Pack.Injuries",
    "system": "sdp",
    "path": "packs/injuries",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "talents",
    "label": "SDP.Pack.Talents",
    "system": "sdp",
    "path": "packs/talents",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "skills",
    "label": "SDP.Pack.Skills",
    "system": "sdp",
    "path": "packs/skills",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "species",
    "label": "SDP.Pack.Species",
    "system": "sdp",
    "path": "packs/species",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "careers",
    "label": "SDP.Pack.Careers",
    "system": "sdp",
    "path": "packs/careers",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "sign",
    "label": "SDP.Pack.Signs",
    "system": "sdp",
    "path": "packs/sign",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "corruption",
    "label": "SDP.Pack.Corruptions",
    "system": "sdp",
    "path": "packs/corruption",
    "type": "Item",
    "banner": "systems/sdp/assets/icons/default-banner.png"
  },

  {
    "name": "rolltables",
    "label": "SDP Roll Tables",
    "path": "packs/rolltables",
    "type": "RollTable",
    "system": "sdp"
  }

],

  "relationships": {
  "requires": [
    {
      "id": "socketlib",
      "type": "module"
    }
  ]
},

  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value",
          "system.details.personalAmbitions.value",
          "system.details.partyAmbitions.value"
        ]
      },
      "npc": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value"
        ]
      },
      "creature": {
        "htmlFields": [
          "system.details.gmNotes.value",
          "system.details.playerNotes.value",
          "system.details.motivation.value"
        ]
      }
    },
    "Item": {
  "skill": {
    "label": "TYPES.Item.skill"
  },
  "talent": {
    "label": "TYPES.Item.talent"
  },
  "weapon": {
    "label": "TYPES.Item.weapon"
  },
  "armor": {
    "label": "TYPES.Item.armor"
  },
  "spell": {
    "label": "TYPES.Item.spell"
  },
  "injury": {
    "label": "TYPES.Item.injury"
  },
  "specie": {
    "label": "TYPES.Item.specie"
  },
  "career": {
    "label": "TYPES.Item.career"
  },
  "sign": {
    "label": "TYPES.Item.sign"
  },
  "ammunition": {
    "label": "TYPES.Item.ammunition"
  },
  "possession": {
    "label": "TYPES.Item.possession"
  },
  "disease": {
    "label": "TYPES.Item.disease"
  },
  "trait": {
    "label": "TYPES.Item.trait"
  },
  "clothing": {
    "label": "TYPES.Item.clothing"
  },
  "container": {
    "label": "TYPES.Item.container"
  },
  "currency": {
    "label": "TYPES.Item.currency"
  }
}
  }
}
